{
  "name": "@fdpm/zod-bridge",
  "version": "0.2.0",
  "description": "Deterministic, one-way translation from Zod v4 schemas into FDPM PrimitiveTypeDefs, CEL constraints, validators, and approval-page descriptors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^7.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
