{
  "name": "@fdpm/zod-bridge",
  "version": "0.4.0",
  "description": "Deterministic, one-way translation from Zod v4 schemas + a defineDomain() sidecar into a runnable FDPM plugin: DomainProfile, validators, view/product pages, USL-NG Core companion, plus the cap:renderer / cap:importer / cap:exporter / cap:expr-helper derivations and an fdpm-plugin.json + index.ts file emitter. Realization of SPEC-FDPM-BRIDGE for Zod v4.",
  "license": "Apache-2.0",
  "author": "Pedro Anisio Silva <pedroanisio@arc4d3.com>",
  "keywords": [
    "fdpm",
    "zod",
    "schema",
    "plugin",
    "code-generation"
  ],
  "homepage": "https://github.com/pedroanisio/fdpm-cli/tree/main/fdpm-cli/packages/zod-bridge#readme",
  "bugs": {
    "url": "https://github.com/pedroanisio/fdpm-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroanisio/fdpm-cli.git",
    "directory": "fdpm-cli/packages/zod-bridge"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./renderers": {
      "import": "./dist/renderers.js",
      "types": "./dist/renderers.d.ts"
    },
    "./io": {
      "import": "./dist/io.js",
      "types": "./dist/io.d.ts"
    },
    "./cel": {
      "import": "./dist/expr-helper.js",
      "types": "./dist/expr-helper.d.ts"
    },
    "./scaffold": {
      "import": "./dist/scaffold.js",
      "types": "./dist/scaffold.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^7.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
