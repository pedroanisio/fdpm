{
  "id": "fdpm.software-architecture",
  "version": "1.1.0",
  "spec_version": "1.1.0",
  "kind": "server",
  "name": "Software Architecture",
  "description": "Primitives, relations, and validation rules for documenting software systems including domain models, services, APIs, state machines, decisions, and operational behavior. Port of src/fdpm/plugins/software_architecture.py.",
  "authors": ["FDPM Maintainers"],
  "license": "MIT",
  "host_compatibility": { "fdpm": ">=1.1,<2" },
  "permissions": [
    "read:workbooks",
    "read:primitives",
    "read:relations",
    "render:server",
    "import:workbook",
    "export:workbook"
  ],
  "capabilities": [
    {
      "capability_id": "cap:profile",
      "local_name": "software-architecture",
      "entry": "PROFILE"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-install",
      "entry": "onInstall"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-enable",
      "entry": "onEnable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-disable",
      "entry": "onDisable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-uninstall",
      "entry": "onUninstall"
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "openapi",
      "entry": "renderOpenApi",
      "metadata": {
        "renderer_id": "sw:OpenAPIRenderer",
        "target": "application/x-yaml",
        "output_path": "openapi.yaml"
      }
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "adr",
      "entry": "renderAdr",
      "metadata": {
        "renderer_id": "sw:ADRRenderer",
        "target": "text/markdown",
        "output_path": "decisions.md"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "http-method-canonical",
      "metadata": {
        "rule_id": "sw:val:http-method-canonical",
        "type_id": "sw:Endpoint"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "deprecated-since-required",
      "metadata": {
        "rule_id": "sw:val:deprecated-since-required",
        "type_id": "sw:Endpoint"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "proposed-no-decided-at",
      "metadata": {
        "rule_id": "sw:val:proposed-no-decided-at",
        "type_id": "sw:Decision"
      }
    },
    {
      "capability_id": "cap:expr-helper",
      "local_name": "endpoint-route",
      "metadata": {
        "helper_id": "fn.fdpm.software-architecture.endpoint-route",
        "arity": 2
      }
    },
    {
      "capability_id": "cap:transformer",
      "local_name": "capability-to-endpoint",
      "metadata": {
        "from_type_id": "sw:Capability",
        "to_type_id": "sw:Endpoint",
        "name": "sw:capability-to-endpoint"
      }
    },
    {
      "capability_id": "cap:importer",
      "local_name": "sw-jsonl",
      "metadata": {
        "format": "sw-jsonl",
        "description": "JSON Lines bundle of sw:* primitives + relations."
      }
    },
    {
      "capability_id": "cap:exporter",
      "local_name": "sw-jsonl",
      "metadata": {
        "format": "sw-jsonl",
        "description": "JSON Lines export filtered to sw:* primitives + relations."
      }
    }
  ]
}
