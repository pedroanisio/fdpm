{
  "id": "fdpm.fact-fiction",
  "version": "0.1.0",
  "spec_version": "1.2.0",
  "kind": "server",
  "name": "Fact-Fiction Coupling",
  "description": "Historical-fiction workbench: models the five coupled layers of fact-fiction methodology — facts with shared, first-class sources and multi-assessor confidence; historicity-graded fiction elements; historical constraints; a typed fact-fiction coupling layer; and an arc/chapter/scene manuscript structure with cascading narrative-style overrides resolved by the outline renderer.",
  "authors": ["FDPM Maintainers"],
  "license": "MIT",
  "host_compatibility": {
    "fdpm": ">=1.1,<2",
    "expr_helper_set": ">=1.1.0,<2"
  },
  "permissions": [
    "read:workbooks",
    "read:primitives",
    "read:relations",
    "render:server"
  ],
  "capabilities": [
    {
      "capability_id": "cap:profile",
      "local_name": "fact-fiction",
      "entry": "PROFILE"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-install",
      "entry": "onInstall"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-enable",
      "entry": "onEnable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-disable",
      "entry": "onDisable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-uninstall",
      "entry": "onUninstall"
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "manuscript-outline",
      "entry": "renderManuscriptOutline",
      "metadata": {
        "renderer_id": "ff:ManuscriptOutlineRenderer",
        "target": "text/markdown",
        "output_path": "outline.md"
      }
    }
  ]
}
