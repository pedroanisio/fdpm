{
  "id": "fdpm.planning",
  "version": "0.1.0",
  "spec_version": "1.1.0",
  "kind": "server",
  "name": "Planning",
  "description": "Planning-and-tracking profile for software implementation and testing workflows. Covers work breakdown, per-task acceptance criteria (free-text and CEL-evaluable), dependency and blocker management, descriptive Gantt scheduling, and concurrent execution by humans and multiple AI agents working in parallel. AI-task durations are bounded to [5,60] minutes in 5-minute steps.",
  "authors": ["FDPM Maintainers"],
  "license": "MIT",
  "host_compatibility": {
    "fdpm": ">=1.1,<2",
    "expr_helper_set": ">=1.1.0,<2"
  },
  "permissions": [
    "read:workbooks",
    "read:primitives",
    "read:relations",
    "render:server",
    "import:workbook",
    "export:workbook"
  ],
  "capabilities": [
    {
      "capability_id": "cap:profile",
      "local_name": "planning",
      "entry": "PROFILE"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-install",
      "entry": "onInstall"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-enable",
      "entry": "onEnable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-disable",
      "entry": "onDisable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-uninstall",
      "entry": "onUninstall"
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "roadmap",
      "entry": "renderRoadmap",
      "metadata": {
        "renderer_id": "plan:RoadmapRenderer",
        "target": "text/markdown",
        "output_path": "roadmap.md"
      }
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "gantt",
      "entry": "renderGantt",
      "metadata": {
        "renderer_id": "plan:GanttSvgRenderer",
        "target": "image/svg+xml",
        "output_path": "gantt.svg"
      }
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "agent-board",
      "entry": "renderAgentBoard",
      "metadata": {
        "renderer_id": "plan:AgentBoardRenderer",
        "target": "text/markdown",
        "output_path": "board.md"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "ai-minutes-numeric-bucket",
      "metadata": {
        "rule_id": "plan:val:ai-minutes-numeric-bucket",
        "type_id": "plan:Task"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "iteration-name-non-empty",
      "metadata": {
        "rule_id": "plan:val:iteration-name-non-empty",
        "type_id": "plan:Iteration"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "blocker-opened-not-future",
      "metadata": {
        "rule_id": "plan:val:blocker-opened-not-future",
        "type_id": "plan:Blocker"
      }
    },
    {
      "capability_id": "cap:expr-helper",
      "local_name": "minutes-to-hours",
      "metadata": {
        "helper_id": "fn.fdpm.planning.minutes-to-hours",
        "arity": 1
      }
    },
    {
      "capability_id": "cap:transformer",
      "local_name": "task-to-ac",
      "metadata": {
        "from_type_id": "plan:Task",
        "to_type_id": "plan:AcceptanceCriterion",
        "name": "plan:task-to-ac"
      }
    },
    {
      "capability_id": "cap:importer",
      "local_name": "plan-jsonl",
      "metadata": {
        "format": "plan-jsonl",
        "description": "JSON Lines bundle of plan:* primitives + relations."
      }
    },
    {
      "capability_id": "cap:exporter",
      "local_name": "plan-jsonl",
      "metadata": {
        "format": "plan-jsonl",
        "description": "JSON Lines export filtered to plan:* primitives + relations."
      }
    }
  ]
}
