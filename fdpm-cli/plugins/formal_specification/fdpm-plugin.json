{
  "id": "fdpm.formal-specification",
  "version": "3.1.0",
  "spec_version": "1.1.0",
  "kind": "server",
  "name": "Formal Specification",
  "description": "Primitives, relations, validation rules, and renderers (markdown / html / pdf) for modeling formal specifications, technical papers, and typed execution roadmaps.",
  "authors": ["FDPM Maintainers"],
  "license": "MIT",
  "host_compatibility": { "fdpm": ">=1.1,<2" },
  "permissions": [
    "read:projects",
    "read:primitives",
    "read:relations",
    "render:server",
    "import:project",
    "export:project"
  ],
  "capabilities": [
    {
      "capability_id": "cap:profile",
      "local_name": "formal-specification",
      "entry": "PROFILE"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-install",
      "entry": "onInstall"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-enable",
      "entry": "onEnable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-disable",
      "entry": "onDisable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-uninstall",
      "entry": "onUninstall"
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "spec-md",
      "entry": "renderMarkdown",
      "metadata": {
        "renderer_id": "fs:SpecRenderer",
        "output_format": "text/markdown",
        "output_path": "spec.md"
      }
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "spec-html",
      "entry": "renderHtml",
      "metadata": {
        "renderer_id": "fs:SpecHtmlRenderer",
        "output_format": "text/html",
        "output_path": "spec.html"
      }
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "spec-pdf",
      "entry": "renderPdf",
      "metadata": {
        "renderer_id": "fs:SpecPdfRenderer",
        "output_format": "application/pdf",
        "output_path": "spec.pdf"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "ci-invariant-justified",
      "metadata": {
        "rule_id": "fs:val:ci-invariant-justified",
        "type_id": "fs:Invariant"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "section-length-cap",
      "metadata": {
        "rule_id": "fs:val:section-length-cap",
        "type_id": "fs:Section"
      }
    },
    {
      "capability_id": "cap:validator",
      "local_name": "doi-canonical-url",
      "metadata": {
        "rule_id": "fs:val:doi-canonical-url",
        "type_id": "fs:Citation"
      }
    },
    {
      "capability_id": "cap:expr-helper",
      "local_name": "section-depth",
      "metadata": {
        "helper_id": "fn.fdpm.formal-specification.section-depth",
        "arity": 1
      }
    },
    {
      "capability_id": "cap:transformer",
      "local_name": "formal-property-to-invariant",
      "metadata": {
        "from_type_id": "fs:FormalProperty",
        "to_type_id": "fs:Invariant",
        "name": "fs:formal-property-to-invariant"
      }
    },
    {
      "capability_id": "cap:importer",
      "local_name": "fs-jsonl",
      "metadata": {
        "format": "fs-jsonl",
        "description": "JSON Lines bundle of fs:* primitives + relations."
      }
    },
    {
      "capability_id": "cap:exporter",
      "local_name": "fs-jsonl",
      "metadata": {
        "format": "fs-jsonl",
        "description": "JSON Lines export filtered to fs:* primitives + relations."
      }
    }
  ]
}
