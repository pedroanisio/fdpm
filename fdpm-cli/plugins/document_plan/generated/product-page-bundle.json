    },
    {
      "flag": "declared-loss:superrefine.cross-references",
      "reason": "completeness-loss (sound-but-not-complete): Reference resolution, concept introduction order, thread continuity, word budgets, milestone deadlines and the dependency DAG (DocumentPlanSchema.superRefine) are enforced by DocumentPlanSchema.safeParse at ingest (build.ts); the host's relation pipeline enforces endpoint existence afterwards. No CEL is emitted for them.",
      "state": "behind-flag"
    },
    {
      "flag": "declared-loss:assertion-text.self-referential-refine",
      "reason": "completeness-loss (sound-but-not-complete): The AssertionText .refine (rejects plan text written in the voice of the document) has no CEL translation; it is enforced by the per-entity Zod validator for header fields and by ingest-time safeParse for node content.",
      "state": "behind-flag"
    },
    {
      "flag": "declared-loss:content-source.identifier.discriminated-union",
      "reason": "soundness-loss (complete-but-not-sound): SourceIdentifier is stored as the flat {kind, value} struct (SourceIdentifierFlat); per-kind value formats are checked only at ingest time by DocumentPlanSchema.safeParse, not on later primitive patches.",
      "state": "behind-flag"
    }
  ],
