{
  "id": "fdpm.spec-authoring",
  "version": "0.1.0",
  "spec_version": "1.1.0",
  "kind": "server",
  "name": "Spec Authoring",
  "description": "Primitives, relations, validation rules, and renderers for authoring FDPM-style SPEC documents (SPEC-CORE / SPEC-MCP-SERVER house style). Models a SPEC as a typed object graph — Document, Sections, Stakeholders, Quality Attributes, ADRs, Options, Open Questions, References, Terms, Requirements — and renders the full Markdown SPEC with the canonical structure (frontmatter, PALS banner, disclaimer, numbered sections, ADR, trade-off matrix, references).",
  "authors": ["FDPM Maintainers"],
  "license": "MIT",
  "host_compatibility": { "fdpm": ">=1.1,<2" },
  "permissions": [
    "read:projects",
    "read:primitives",
    "read:relations",
    "render:server",
    "import:project",
    "export:project"
  ],
  "capabilities": [
    {
      "capability_id": "cap:profile",
      "local_name": "spec-authoring",
      "entry": "PROFILE"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-install",
      "entry": "onInstall"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-enable",
      "entry": "onEnable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-disable",
      "entry": "onDisable"
    },
    {
      "capability_id": "cap:lifecycle-hook",
      "local_name": "on-uninstall",
      "entry": "onUninstall"
    },
    {
      "capability_id": "cap:renderer",
      "local_name": "spec-md",
      "entry": "renderSpecMarkdown",
      "metadata": {
        "renderer_id": "spec:SpecMarkdownRenderer",
        "target": "text/markdown",
        "output_path": "SPEC.md"
      }
    },
    {
      "capability_id": "cap:expr-helper",
      "local_name": "section-number",
      "metadata": {
        "helper_id": "fn.fdpm.spec-authoring.section-number",
        "arity": 1
      }
    },
    {
      "capability_id": "cap:transformer",
      "local_name": "requirement-to-ac",
      "metadata": {
        "from_type_id": "spec:Requirement",
        "to_type_id": "spec:AcceptanceCriterion",
        "name": "spec:requirement-to-ac"
      }
    },
    {
      "capability_id": "cap:importer",
      "local_name": "spec-jsonl",
      "metadata": {
        "format": "spec-jsonl",
        "description": "JSON Lines bundle of spec:* primitives + relations."
      }
    },
    {
      "capability_id": "cap:exporter",
      "local_name": "spec-jsonl",
      "metadata": {
        "format": "spec-jsonl",
        "description": "JSON Lines export filtered to spec:* primitives + relations."
      }
    }
  ]
}
