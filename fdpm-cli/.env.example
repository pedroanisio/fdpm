# FDPM CLI runtime configuration.
# Copy to `.env` or export individual variables in your shell.

# Persistence directory for profiles and project logs.
FDPM_DATA_DIR=~/.fdpm-cli

# Extra plugin search paths (colon-separated).
FDPM_PLUGIN_PATH=

# Plugin logger threshold: debug | info | warn | error | silent.
FDPM_LOG_LEVEL=info

# Truthy -> also emit plugin debug logs.
FDPM_DEBUG=

# Truthy -> expand human-mode error output.
FDPM_VERBOSE=

# Cap on -f / stdin input size in bytes.
FDPM_MAX_REQUEST_BYTES=5242880

# Cap on operations per field-patch request.
FDPM_MAX_FIELD_PATCH_OPS=100

# Max events returned by one log page.
FDPM_LOG_PAGE_MAX=10000

# Cap on operations per edit batch.
FDPM_MAX_BATCH_OPS=500

# Max bytes of diff evidence in audit projection.
FDPM_AUDIT_DIFF_MAX_BYTES=32768

# Comma-separated keys allowed for verified plugin trust.
FDPM_TRUSTED_KEYS=

# Cap on renderer output size in bytes.
FDPM_MAX_RENDER_BYTES=52428800

# Store snapshot after every N appended operations.
FDPM_SNAPSHOT_EVERY_OPS=1000
