# FDPM CLI runtime configuration.
# Copy to `.env` or export individual variables in your shell.

# BEGIN GENERATED: env-vars (scripts/build-env-docs.ts)

# Persistence directory for profiles and workbook logs.
FDPM_DATA_DIR=~/.fdpm-cli

# Extra plugin search paths separated by the OS path-list delimiter (`:` on POSIX, `;` on Windows).
FDPM_PLUGIN_PATH=

# 0 -> skip the fsync after each operation-log write (faster bulk import, loses the tail on host crash).
FDPM_FSYNC=1

# Plugin logger threshold: debug | info | warn | error | silent.
FDPM_LOG_LEVEL=info

# Truthy -> also emit plugin debug logs.
FDPM_DEBUG=

# Truthy -> expand human-mode error output.
FDPM_VERBOSE=

# 1 -> emit compact (single-line) JSON; set by `fdpm repl --json` and SPEC-MCP-SERVER.
FDPM_JSON_COMPACT=

# Cap on -f / stdin input size in bytes.
FDPM_MAX_REQUEST_BYTES=5242880

# Cap on operations per field-patch request.
FDPM_MAX_FIELD_PATCH_OPS=100

# Max events returned by one log page.
FDPM_LOG_PAGE_MAX=10000

# Cap on operations per edit batch.
FDPM_MAX_BATCH_OPS=500

# Max bytes of diff evidence in audit projection.
FDPM_AUDIT_DIFF_MAX_BYTES=32768

# Comma-separated keys allowed for verified plugin trust.
FDPM_TRUSTED_KEYS=maintainer-key-1,maintainer-key-2

# Cap on renderer output size in bytes.
FDPM_MAX_RENDER_BYTES=52428800

# Store snapshot after every N appended operations.
FDPM_SNAPSHOT_EVERY_OPS=1000

# Truthy -> fdpm-mcp constructs Host with noPlugins=true.
FDPM_NO_PLUGINS=

# Fdpm-mcp: truthy -> expose Tier-3 destructive tools (off by default).
FDPM_MCP_ENABLE_DESTRUCTIVE=

# Fdpm-mcp: comma-separated plugin ids whose MCP tools are exposed.
FDPM_MCP_ENABLE_PLUGINS=plugin-id-1,plugin-id-2

# Fdpm-mcp: per-session rate limit on tool calls.
FDPM_MCP_MAX_CALLS_PER_MINUTE=120

# Fdpm-mcp: truthy -> log full args (default: sha256 hash only).
FDPM_MCP_AUDIT_FULL_ARGS=

# SPEC-MCP-SERVER §9.3: exactly `1` gates Tier 2/3 calls behind an `_confirmation_token` argument; requires FDPM_MCP_CONFIRMATION_TOKEN.
FDPM_MCP_REQUIRE_CONFIRMATION_TOKEN=

# Fdpm-mcp: the token Tier 2/3 calls must present when the gate above is on; startup refuses if the gate is on and this is empty.
FDPM_MCP_CONFIRMATION_TOKEN=

# Fdpm-mcp: cap on the UTF-8 byte size of the advertised tools/list catalog; boot refuses when exceeded (SPEC-MCP-SERVER §8.5).
FDPM_MCP_CATALOG_BUDGET_BYTES=26000

# SPEC-WORKSPACE §8.3: workspace id or name to resolve via the registry; ignored when FDPM_DATA_DIR is set.
FDPM_WORKSPACE=

# SPEC-WORKSPACE §12: override the native operator-local registry path (XDG state on Linux, Application Support on macOS, LocalAppData on Windows).
FDPM_REGISTRY_PATH=./.fdpm-state/workspaces.json

# END GENERATED: env-vars

