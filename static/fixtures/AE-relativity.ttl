# AE-relativity.ttl
#
# Fixture for static/schemas/scientific-paper-cwa-shacl-rev2.ttl (Layer B,
# the academic-paper.ts mirror). Models the 1920 English translation of
# Einstein's "Relativity: The Special and General Theory" (Robert W.
# Lawson, trans.; Methuen & Co Ltd) — source PDF at
# static/fixtures/AE-relativity.pdf.
#
# Targets Layer B (ap:* shapes). Layer A (ex:PersonShape, etc.) is
# deliberately not exercised here because its bibliographic posture
# requires ORCID identifiers, which neither Einstein (d. 1955) nor
# Lawson (d. 1960) had — ORCID launched 2012.
#
# Positive-case fixture: every Layer-B SHACL rule should report
# conformance. To use as a regression smoke test:
#
#   pyshacl -s static/schemas/scientific-paper-cwa-shacl-rev2.ttl \
#           -d static/fixtures/AE-relativity.ttl -f turtle
#
# Generated by Claude Opus 4.7 on 2026-05-10. Per PALS's LAW: factual
# attributions to historical figures (birth/death years, affiliations,
# CRediT-style contribution roles attributed retroactively) are encoded
# as best-effort schema fixtures, not authoritative biographical claims.

@prefix ap:   <https://example.org/academic-paper/> .
@prefix d:    <https://example.org/data/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ─────────────────────────────────────────────────────────────────────────
# Paper — the 1920 English-translation publication record.
# ─────────────────────────────────────────────────────────────────────────
d:paper-relativity-1920 a ap:Paper ;
    ap:id              d:paper-relativity-1920 ;
    ap:title           "Relativity: The Special and General Theory" ;
    ap:abstract        "An exposition of the special and general theories of relativity for readers without a mathematical background, organised in three parts (Special Theory; General Theory; Considerations on the Universe as a Whole) plus five appendices. The author treats the empirical foundations of the theory in a 'step-motherly' fashion, prioritising conceptual clarity over experimental detail." ;
    ap:language        "en" ;
    ap:epistemicMethod "theoretical" ;
    ap:format          "monograph" ;
    ap:publisher       "Methuen & Co Ltd" ;
    ap:year            1920 ;
    ap:license         <https://www.gnu.org/licenses/fdl.txt> ;
    ap:pageCount       115 ;
    ap:keywords        "relativity", "special relativity", "general relativity",
                       "Lorentz transformation", "space-time", "gravitation" .

# ─────────────────────────────────────────────────────────────────────────
# Authors + Affiliation
# ─────────────────────────────────────────────────────────────────────────
d:author-einstein a ap:Author ;
    ap:id            d:author-einstein ;
    ap:paper         d:paper-relativity-1920 ;
    ap:fullName      "Albert Einstein" ;
    ap:familyName    "Einstein" ;
    ap:givenNames    "Albert" ;
    ap:role          "lead" ;
    ap:position      "first" ;
    ap:affiliations  d:affil-prussian-academy ;
    ap:contributions "conceptualization", "writing-original-draft", "methodology" .

d:author-lawson a ap:Author ;
    ap:id            d:author-lawson ;
    ap:paper         d:paper-relativity-1920 ;
    ap:fullName      "Robert W. Lawson" ;
    ap:familyName    "Lawson" ;
    ap:givenNames    "Robert William" ;
    ap:role          "translator" ;
    ap:position      "last" ;
    ap:affiliations  d:affil-sheffield ;
    ap:contributions "writing-review-editing" .

d:affil-prussian-academy a ap:Affiliation ;
    ap:id          d:affil-prussian-academy ;
    ap:institution "Royal Prussian Academy of Sciences" ;
    ap:country     "DE" .

d:affil-sheffield a ap:Affiliation ;
    ap:id          d:affil-sheffield ;
    ap:institution "University of Sheffield" ;
    ap:department  "Department of Physics" ;
    ap:country     "GB" .

# ─────────────────────────────────────────────────────────────────────────
# Sections — preface + the three parts + appendices
# ─────────────────────────────────────────────────────────────────────────
d:section-preface a ap:Section ;
    ap:id     d:section-preface ;
    ap:paper  d:paper-relativity-1920 ;
    ap:label  "Preface" ;
    ap:title  "Preface (December, 1916)" ;
    ap:order  0 ;
    ap:role   "preface" ;
    ap:language "en" .

d:section-part-i a ap:Section ;
    ap:id    d:section-part-i ;
    ap:paper d:paper-relativity-1920 ;
    ap:label "Part I" ;
    ap:title "The Special Theory of Relativity" ;
    ap:order 1 ;
    ap:role  "body" .

d:section-part-ii a ap:Section ;
    ap:id     d:section-part-ii ;
    ap:paper  d:paper-relativity-1920 ;
    ap:label  "Part II" ;
    ap:title  "The General Theory of Relativity" ;
    ap:order  2 ;
    ap:role   "body" .

d:section-part-iii a ap:Section ;
    ap:id     d:section-part-iii ;
    ap:paper  d:paper-relativity-1920 ;
    ap:label  "Part III" ;
    ap:title  "Considerations on the Universe as a Whole" ;
    ap:order  3 ;
    ap:role   "body" .

d:section-ch-11 a ap:Section ;
    ap:id     d:section-ch-11 ;
    ap:paper  d:paper-relativity-1920 ;
    ap:parent d:section-part-i ;
    ap:label  "11" ;
    ap:title  "The Lorentz Transformation" ;
    ap:order  11 ;
    ap:role   "body" .

d:section-ch-13 a ap:Section ;
    ap:id     d:section-ch-13 ;
    ap:paper  d:paper-relativity-1920 ;
    ap:parent d:section-part-i ;
    ap:label  "13" ;
    ap:title  "Theorem of the Addition of Velocities. The Experiment of Fizeau" ;
    ap:order  13 ;
    ap:role   "body" .

d:section-ch-15 a ap:Section ;
    ap:id     d:section-ch-15 ;
    ap:paper  d:paper-relativity-1920 ;
    ap:parent d:section-part-i ;
    ap:label  "15" ;
    ap:title  "General Results of the Theory" ;
    ap:order  15 ;
    ap:role   "body" .

d:section-appendices a ap:Section ;
    ap:id     d:section-appendices ;
    ap:paper  d:paper-relativity-1920 ;
    ap:label  "App." ;
    ap:title  "Appendices" ;
    ap:order  4 ;
    ap:role   "appendix" .

# ─────────────────────────────────────────────────────────────────────────
# Claims — Einstein's two postulates + a representative theoretical claim.
# Note: PaperEpistemicMethod='theoretical' does NOT require a hypothesis
# Claim (only 'empirical' does). This fixture has postulates and a
# theoretical claim, no hypothesis Claim.
# ─────────────────────────────────────────────────────────────────────────
d:claim-postulate-relativity a ap:Claim ;
    ap:id        d:claim-postulate-relativity ;
    ap:paper     d:paper-relativity-1920 ;
    ap:section   d:section-part-i ;
    ap:kind      "postulate" ;
    ap:statement "The principle of relativity holds true: the laws of physics take the same form in all inertial reference frames." ;
    ap:confidence d:confidence-postulate-1 .

d:claim-postulate-light a ap:Claim ;
    ap:id        d:claim-postulate-light ;
    ap:paper     d:paper-relativity-1920 ;
    ap:section   d:section-part-i ;
    ap:kind      "postulate" ;
    ap:statement "The velocity of transmission of light in vacuo has to be considered equal to a constant c, independent of the motion of the source." ;
    ap:confidence d:confidence-postulate-2 .

d:claim-lorentz-covariance a ap:Claim ;
    ap:id          d:claim-lorentz-covariance ;
    ap:paper       d:paper-relativity-1920 ;
    ap:section     d:section-ch-15 ;
    ap:kind        "interpretive" ;
    ap:statement   "General laws of nature are co-variant with respect to Lorentz transformations." ;
    ap:derivesFrom d:claim-postulate-relativity, d:claim-postulate-light .

d:confidence-postulate-1 a ap:Confidence ; ap:level "high"     ; ap:score 0.95 .
d:confidence-postulate-2 a ap:Confidence ; ap:level "verified" ; ap:score 0.99 .

# ─────────────────────────────────────────────────────────────────────────
# Equations — required because epistemicMethod='theoretical'
# ─────────────────────────────────────────────────────────────────────────
d:eq-time-dilation a ap:Equation ;
    ap:id      d:eq-time-dilation ;
    ap:paper   d:paper-relativity-1920 ;
    ap:section d:section-ch-11 ;
    ap:label   "Time-dilation factor" ;
    ap:tex     "\\frac{1}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role    "derived" .

d:eq-velocity-addition a ap:Equation ;
    ap:id             d:eq-velocity-addition ;
    ap:paper          d:paper-relativity-1920 ;
    ap:section        d:section-ch-13 ;
    ap:label          "(B) — relativistic velocity addition" ;
    ap:tex            "W = \\frac{v + w}{1 + \\frac{vw}{c^{2}}}" ;
    ap:role           "derived" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light .

d:eq-rest-energy a ap:Equation ;
    ap:id             d:eq-rest-energy ;
    ap:paper          d:paper-relativity-1920 ;
    ap:section        d:section-ch-15 ;
    ap:label          "Relativistic kinetic energy" ;
    ap:tex            "\\frac{m c^{2}}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role           "derived" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light ;
    ap:derivesFrom    d:eq-time-dilation .

# ─────────────────────────────────────────────────────────────────────────
# Quotation — Einstein's preface line about Boltzmann.
# ─────────────────────────────────────────────────────────────────────────
d:quote-boltzmann a ap:Quotation ;
    ap:id                d:quote-boltzmann ;
    ap:paper             d:paper-relativity-1920 ;
    ap:section           d:section-preface ;
    ap:quotesFrom        d:work-boltzmann-source ;
    ap:locator           "Preface, p. 5" ;
    ap:body              "matters of elegance ought to be left to the tailor and to the cobbler" ;
    ap:bodyLanguage      "en" ;
    ap:emphasis          "none" ;
    ap:omissionsPresent  false .

# ─────────────────────────────────────────────────────────────────────────
# Cited Works
# ─────────────────────────────────────────────────────────────────────────
d:work-relativity-de-1916 a ap:Work ;
    ap:id              d:work-relativity-de-1916 ;
    ap:kind            "book" ;
    ap:title           "Über die spezielle und die allgemeine Relativitätstheorie, gemeinverständlich" ;
    ap:authorsFreeText "Albert Einstein" ;
    ap:year            1916 ;
    ap:publisher       "Vieweg" ;
    ap:language        "de" .

d:work-fizeau-1851 a ap:Work ;
    ap:id              d:work-fizeau-1851 ;
    ap:kind            "journal-article" ;
    ap:title           "Sur les hypothèses relatives à l'éther lumineux" ;
    ap:authorsFreeText "Hippolyte Fizeau" ;
    ap:year            1851 ;
    ap:venue           "Comptes Rendus de l'Académie des Sciences" ;
    ap:language        "fr" .

d:work-boltzmann-source a ap:Work ;
    ap:id              d:work-boltzmann-source ;
    ap:kind            "other" ;
    ap:title           "Attributed remark on elegance in scientific exposition" ;
    ap:authorsFreeText "Ludwig Boltzmann" ;
    ap:language        "de" .

d:work-lorentz-electrons a ap:Work ;
    ap:id              d:work-lorentz-electrons ;
    ap:kind            "book" ;
    ap:title           "The Theory of Electrons and Its Applications to the Phenomena of Light and Radiant Heat" ;
    ap:authorsFreeText "H. A. Lorentz" ;
    ap:year            1909 ;
    ap:publisher       "B. G. Teubner" ;
    ap:language        "en" .

# ─────────────────────────────────────────────────────────────────────────
# Citations — typed cito:cites-aligned links
# ─────────────────────────────────────────────────────────────────────────
d:citation-fizeau a ap:Citation ;
    ap:id            d:citation-fizeau ;
    ap:paper         d:paper-relativity-1920 ;
    ap:citingClaim   d:claim-lorentz-covariance ;
    ap:citingSection d:section-ch-13 ;
    ap:citingLocator "p. 38" ;
    ap:citedWork     d:work-fizeau-1851 ;
    ap:kind          "confirms" ;
    ap:rationale     "Fizeau's experimental result for the propagation of light in moving water agrees with the relativistic velocity-addition formula (B), confirming the relativistic prediction over the Galilean (A) within 1% per Zeeman's later measurements." .

d:citation-lorentz a ap:Citation ;
    ap:id            d:citation-lorentz ;
    ap:paper         d:paper-relativity-1920 ;
    ap:citingClaim   d:claim-lorentz-covariance ;
    ap:citingSection d:section-ch-13 ;
    ap:citedWork     d:work-lorentz-electrons ;
    ap:kind          "obtains-background-from" ;
    ap:rationale     "Lorentz's electrodynamic theory predates relativity and explains the Fizeau result via electromagnetic structure of matter; Einstein notes this does not diminish Fizeau as a crucial test of relativity since Maxwell-Lorentz electrodynamics is consistent with the relativistic re-derivation." .

d:citation-original-de a ap:Citation ;
    ap:id            d:citation-original-de ;
    ap:paper         d:paper-relativity-1920 ;
    ap:citedWork     d:work-relativity-de-1916 ;
    ap:kind          "cites-as-related" ;
    ap:rationale     "This 1920 English edition is Lawson's authorised translation of the 1916 German original." .

# ─────────────────────────────────────────────────────────────────────────
# PaperRelation — translation-of (paper-level Crossmark-style metadata)
# ─────────────────────────────────────────────────────────────────────────
d:prel-translation a ap:PaperRelation ;
    ap:id          d:prel-translation ;
    ap:paper       d:paper-relativity-1920 ;
    ap:relatedWork d:work-relativity-de-1916 ;
    ap:kind        "translation-of" ;
    ap:rationale   "Lawson's authorised English translation of Einstein's 1916 German monograph." .

# ─────────────────────────────────────────────────────────────────────────
# Concepts + Definition + Theorist (each Concept must be defined OR borrowed)
# ─────────────────────────────────────────────────────────────────────────
d:concept-lorentz-tx a ap:Concept ;
    ap:id     d:concept-lorentz-tx ;
    ap:label  "Lorentz transformation" ;
    ap:domain "theoretical physics" ;
    ap:borrowsFrom d:theorist-lorentz .

d:concept-relativity-principle a ap:Concept ;
    ap:id     d:concept-relativity-principle ;
    ap:label  "principle of relativity (restricted sense)" ;
    ap:domain "theoretical physics" .

d:concept-simultaneity a ap:Concept ;
    ap:id     d:concept-simultaneity ;
    ap:label  "relativity of simultaneity" ;
    ap:domain "theoretical physics" .

d:defn-relativity a ap:Definition ;
    ap:id          d:defn-relativity ;
    ap:paper       d:paper-relativity-1920 ;
    ap:concept     d:concept-relativity-principle ;
    ap:section     d:section-part-i ;
    ap:body        "The principle that, in the restricted sense, the laws of physics take the same form in all reference systems in uniform translation relative to one another (Galileian systems)." ;
    ap:provenance  "stipulated" .

d:defn-simultaneity a ap:Definition ;
    ap:id          d:defn-simultaneity ;
    ap:paper       d:paper-relativity-1920 ;
    ap:concept     d:concept-simultaneity ;
    ap:section     d:section-part-i ;
    ap:body        "Two events that are simultaneous with respect to one inertial frame are not in general simultaneous with respect to another inertial frame in motion relative to the first." ;
    ap:provenance  "derived" .

d:theorist-lorentz a ap:Theorist ;
    ap:id                  d:theorist-lorentz ;
    ap:fullName            "Hendrik Antoon Lorentz" ;
    ap:familyName          "Lorentz" ;
    ap:birthYear           1853 ;
    ap:deathYear           1928 ;
    ap:primaryAffiliation  "Leiden University" .

# ─────────────────────────────────────────────────────────────────────────
# Theory + Method + Finding + Limitation + Footnote + Figure
# ─────────────────────────────────────────────────────────────────────────
d:theory-special-relativity a ap:Theory ;
    ap:id               d:theory-special-relativity ;
    ap:name             "Special Theory of Relativity" ;
    ap:summary          "Theory uniting the principle of relativity with the constancy of c, yielding the Lorentz transformation as the law relating space-time coordinates between inertial frames." ;
    ap:primaryTheorist  d:theorist-lorentz .

d:theory-general-relativity a ap:Theory ;
    ap:id               d:theory-general-relativity ;
    ap:name             "General Theory of Relativity" ;
    ap:summary          "Extension of special relativity to non-inertial reference frames and gravitation, treating gravity as the curvature of space-time." ;
    ap:extendsTheory    d:theory-special-relativity .

d:method-axiomatic a ap:Method ;
    ap:id        d:method-axiomatic ;
    ap:paper     d:paper-relativity-1920 ;
    ap:name      "axiomatic-deductive exposition" ;
    ap:kind      "theoretical" ;
    ap:procedure "Take the principle of relativity and the constancy of c as postulates; derive the Lorentz transformation; from the Lorentz transformation, derive time dilation, length contraction, the relativistic velocity-addition law, and the mass-energy relation." .

d:finding-fizeau-agreement a ap:Finding ;
    ap:id        d:finding-fizeau-agreement ;
    ap:paper     d:paper-relativity-1920 ;
    ap:section   d:section-ch-13 ;
    ap:statement "Fizeau's measured velocity of light in moving water matches the relativistic velocity-addition formula (B) to within ~1% per Zeeman's measurements, providing a crucial empirical test of the special theory." .

d:limit-empirical-treatment a ap:Limitation ;
    ap:id        d:limit-empirical-treatment ;
    ap:paper     d:paper-relativity-1920 ;
    ap:statement "The author has 'purposely treated the empirical physical foundations of the theory in a step-motherly fashion' (Preface), so readers seeking detailed experimental coverage will need to consult primary sources." ;
    ap:scope     "empirical" .

d:note-fizeau-formula a ap:Footnote ;
    ap:id       d:note-fizeau-formula ;
    ap:paper    d:paper-relativity-1920 ;
    ap:section  d:section-ch-13 ;
    ap:label    "1" ;
    ap:body     "Fizeau found W = w + v(1 - 1/n²), where n = c/w is the index of refraction of the liquid. To first order in vw/c², equation (B) reduces to Fizeau's result." ;
    ap:language "en" .

d:fig-fizeau-tube a ap:Figure ;
    ap:id              d:fig-fizeau-tube ;
    ap:paper           d:paper-relativity-1920 ;
    ap:section         d:section-ch-13 ;
    ap:label           "Fig. 3" ;
    ap:caption         "Schematic of the Fizeau apparatus: a tube T through which liquid flows with velocity v; light propagates along the tube." ;
    ap:captionLanguage "en" ;
    ap:page            39 ;
    ap:altText         "Two horizontal lines representing the walls of a tube T, with an arrow labelled v inside indicating the direction of liquid flow." .
