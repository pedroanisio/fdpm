# =========================================================================
# Claims — postulates + key theoretical & interpretive claims
# =========================================================================
d:claim-postulate-relativity a ap:Claim ;
    ap:id d:claim-postulate-relativity ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-05 ; ap:kind "postulate" ;
    ap:statement "The principle of relativity (in the restricted sense): if K is a Galileian co-ordinate system, then every other co-ordinate system K' moving in uniform translation relative to K is also Galileian; natural phenomena run their course with respect to K' according to exactly the same general laws as with respect to K." ;
    ap:confidence d:confidence-postulate-1 .

d:claim-postulate-light a ap:Claim ;
    ap:id d:claim-postulate-light ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-07 ; ap:kind "postulate" ;
    ap:statement "The velocity of transmission of light in vacuo has to be considered equal to a constant c (≈ 300,000 km/s), independent of the motion of the source — substantiated by De Sitter's double-star observations." ;
    ap:confidence d:confidence-postulate-2 .

d:claim-postulate-equivalence a ap:Claim ;
    ap:id d:claim-postulate-equivalence ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-20 ; ap:kind "postulate" ;
    ap:statement "Equivalence principle: the gravitational mass of a body is equal to its inertial mass; an observer in an accelerated chest cannot distinguish the resulting forces from those due to a uniform gravitational field." .

d:claim-lorentz-covariance a ap:Claim ;
    ap:id d:claim-lorentz-covariance ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-14 ; ap:kind "interpretive" ;
    ap:statement "General laws of nature are co-variant with respect to Lorentz transformations." ;
    ap:derivesFrom d:claim-postulate-relativity, d:claim-postulate-light .

d:claim-simultaneity-relative a ap:Claim ;
    ap:id d:claim-simultaneity-relative ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-09 ; ap:kind "interpretive" ;
    ap:statement "Events which are simultaneous with reference to the embankment are not simultaneous with respect to the train, and vice versa: every reference-body has its own particular time." ;
    ap:derivesFrom d:claim-postulate-relativity, d:claim-postulate-light .

d:claim-mass-energy a ap:Claim ;
    ap:id d:claim-mass-energy ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-15 ; ap:kind "definitional" ;
    ap:statement "The inertial mass of a body is not a constant but varies with the energy of the body; mass and energy are unified into one law (E = mc²)." ;
    ap:derivesFrom d:claim-postulate-relativity, d:claim-postulate-light .

d:claim-light-curvature a ap:Claim ;
    ap:id d:claim-light-curvature ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-22 ; ap:kind "empirical" ;
    ap:statement "In general, rays of light are propagated curvilinearly in gravitational fields; for a ray grazing the Sun the deflection is approximately 1.7 seconds of arc." ;
    ap:derivesFrom d:claim-postulate-equivalence .

d:claim-gauss-coordinates a ap:Claim ;
    ap:id d:claim-gauss-coordinates ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-28 ; ap:kind "interpretive" ;
    ap:statement "All Gaussian co-ordinate systems are essentially equivalent for the formulation of the general laws of nature (the 'reference-mollusc' formulation)." ;
    ap:derivesFrom d:claim-lorentz-covariance .

d:claim-finite-unbounded a ap:Claim ;
    ap:id d:claim-finite-unbounded ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-32 ; ap:kind "interpretive" ;
    ap:statement "The universe is, on the basis of the general theory of relativity, finite (closed/spherical or elliptical) yet unbounded; its 'world-radius' relates to the average density of matter via R² = 2/(Kp)." .

d:confidence-postulate-1 a ap:Confidence ; ap:level "high"     ; ap:score 0.95 .
d:confidence-postulate-2 a ap:Confidence ; ap:level "verified" ; ap:score 0.99 .

# =========================================================================
# Equations — representative cross-section spanning all three parts
# =========================================================================

d:eq-galilei-velocity-add a ap:Equation ;
    ap:id d:eq-galilei-velocity-add ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-06 ; ap:label "(A) — Galilean velocity addition" ;
    ap:tex "W = v + w" ; ap:role "derived" .

d:eq-light-galilean-conflict a ap:Equation ;
    ap:id d:eq-light-galilean-conflict ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-07 ; ap:label "Light-vs-relativity conflict" ;
    ap:tex "w = c - v" ; ap:role "derived" .

d:eq-lorentz-x a ap:Equation ;
    ap:id d:eq-lorentz-x ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-11 ; ap:label "Lorentz transformation, x'" ;
    ap:tex "x' = \\frac{x - vt}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role "transformation" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light .

d:eq-lorentz-t a ap:Equation ;
    ap:id d:eq-lorentz-t ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-11 ; ap:label "Lorentz transformation, t'" ;
    ap:tex "t' = \\frac{t - \\frac{v}{c^{2}} x}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role "transformation" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light .

d:eq-galilei-tx a ap:Equation ;
    ap:id d:eq-galilei-tx ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-11 ; ap:label "Galilei transformation (limit c→∞)" ;
    ap:tex "x' = x - vt,\\quad y' = y,\\quad z' = z,\\quad t' = t" ;
    ap:role "transformation" .

d:eq-length-contraction a ap:Equation ;
    ap:id d:eq-length-contraction ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-12 ; ap:label "Length-contraction factor" ;
    ap:tex "L = L_{0} \\sqrt{1 - \\frac{v^{2}}{c^{2}}}" ;
    ap:role "derived" ; ap:derivesFrom d:eq-lorentz-x .

d:eq-time-dilation a ap:Equation ;
    ap:id d:eq-time-dilation ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-12 ; ap:label "Time-dilation factor" ;
    ap:tex "\\Delta t = \\frac{\\Delta t_{0}}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role "derived" ; ap:derivesFrom d:eq-lorentz-t .

d:eq-relativistic-velocity-add a ap:Equation ;
    ap:id d:eq-relativistic-velocity-add ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-13 ; ap:label "(B) — Relativistic velocity addition" ;
    ap:tex "W = \\frac{v + w}{1 + \\frac{vw}{c^{2}}}" ;
    ap:role "derived" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light ;
    ap:derivesFrom d:eq-lorentz-x .

d:eq-fizeau a ap:Equation ;
    ap:id d:eq-fizeau ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-13 ; ap:label "Fizeau result (footnote)" ;
    ap:tex "W = w + v\\left(1 - \\frac{1}{n^{2}}\\right),\\ \\text{where}\\ n = \\frac{c}{w}" ;
    ap:role "empirical-law" .

d:eq-rest-energy a ap:Equation ;
    ap:id d:eq-rest-energy ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-15 ; ap:label "Relativistic kinetic energy" ;
    ap:tex "E_{kin} = \\frac{m c^{2}}{\\sqrt{1 - \\frac{v^{2}}{c^{2}}}}" ;
    ap:role "derived" ;
    ap:fromPostulates d:claim-postulate-relativity, d:claim-postulate-light ;
    ap:derivesFrom d:eq-time-dilation .

d:eq-mass-energy a ap:Equation ;
    ap:id d:eq-mass-energy ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-15 ; ap:label "Mass-energy equivalence" ;
    ap:tex "E = m c^{2}" ;
    ap:role "identity" ; ap:derivesFrom d:eq-rest-energy .

d:eq-newton-acceleration a ap:Equation ;
    ap:id d:eq-newton-acceleration ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-20 ; ap:label "Acceleration ratio (equivalence prelude)" ;
    ap:tex "a = \\frac{m_{grav}}{m_{inert}} \\cdot g" ;
    ap:role "definition" .

d:eq-minkowski-sr a ap:Equation ;
    ap:id d:eq-minkowski-sr ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-26 ; ap:label "Minkowski metric (SR)" ;
    ap:tex "ds^{2} = dx^{2} + dy^{2} + dz^{2} - c^{2} dt^{2}" ;
    ap:role "definition" .

d:eq-gauss-metric a ap:Equation ;
    ap:id d:eq-gauss-metric ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-25 ; ap:label "Gaussian line element" ;
    ap:tex "ds^{2} = g_{11} du^{2} + 2 g_{12}\\, du\\, dv + g_{22} dv^{2}" ;
    ap:role "definition" .

d:eq-mercury-precession a ap:Equation ;
    ap:id d:eq-mercury-precession ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-app-iii ; ap:label "Mercury perihelion advance per orbit" ;
    ap:tex "\\Delta\\phi = \\frac{24 \\pi^{3} a^{2}}{T^{2} c^{2} (1 - e^{2})}" ;
    ap:role "derived" .

d:eq-light-deflection a ap:Equation ;
    ap:id d:eq-light-deflection ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-app-iii ; ap:label "Solar light deflection" ;
    ap:tex "a = \\frac{1.7''}{\\Delta}" ;
    ap:role "derived" .

d:eq-grav-redshift a ap:Equation ;
    ap:id d:eq-grav-redshift ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-app-iii ; ap:label "Gravitational redshift" ;
    ap:tex "\\frac{\\nu_{0} - \\nu}{\\nu_{0}} = \\frac{K}{c^{2}} \\cdot \\frac{M}{r}" ;
    ap:role "derived" .

d:eq-cosmological-radius a ap:Equation ;
    ap:id d:eq-cosmological-radius ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-32 ; ap:label "World-radius (CGS units)" ;
    ap:tex "R^{2} = \\frac{2}{K \\rho}" ;
    ap:role "derived" .

# =========================================================================
# Quotations — verbatim Lawson-translation passages
# =========================================================================

d:quote-boltzmann a ap:Quotation ;
    ap:id d:quote-boltzmann ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-preface ; ap:quotesFrom d:work-boltzmann-source ;
    ap:locator "Preface, p. 5" ;
    ap:body "matters of elegance ought to be left to the tailor and to the cobbler" ;
    ap:bodyLanguage "en" ; ap:emphasis "none" ; ap:omissionsPresent false .

d:quote-step-motherly a ap:Quotation ;
    ap:id d:quote-step-motherly ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-preface ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Preface, p. 5" ;
    ap:body "I have purposely treated the empirical physical foundations of the theory in a 'step-motherly' fashion, so that readers unfamiliar with physics may not feel like the wanderer who was unable to see the forest for the trees." ;
    ap:bodyLanguage "en" ; ap:emphasis "original" ; ap:omissionsPresent false .

d:quote-happy-hours a ap:Quotation ;
    ap:id d:quote-happy-hours ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-preface ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Preface, p. 5" ;
    ap:body "May the book bring some one a few happy hours of suggestive thought!" ;
    ap:bodyLanguage "en" ; ap:emphasis "none" ; ap:omissionsPresent false .

d:quote-covariance a ap:Quotation ;
    ap:id d:quote-covariance ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-14 ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Ch. 14, p. 41" ;
    ap:body "General laws of nature are co-variant with respect to Lorentz transformations." ;
    ap:bodyLanguage "en" ; ap:emphasis "original" ; ap:omissionsPresent false .

d:quote-simultaneity a ap:Quotation ;
    ap:id d:quote-simultaneity ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-09 ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Ch. 9, p. 26" ;
    ap:body "Events which are simultaneous with reference to the embankment are not simultaneous with respect to the train, and vice versa (relativity of simultaneity). Every reference-body (co-ordinate system) has its own particular time; unless we are told the reference-body to which the statement of time refers, there is no meaning in a statement of the time of an event." ;
    ap:bodyLanguage "en" ; ap:emphasis "none" ; ap:omissionsPresent false .

d:quote-curved-light a ap:Quotation ;
    ap:id d:quote-curved-light ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-22 ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Ch. 22, p. 65" ;
    ap:body "in general, rays of light are propagated curvilinearly in gravitational fields" ;
    ap:bodyLanguage "en" ; ap:emphasis "original" ; ap:omissionsPresent false .

d:quote-gauss-equivalence a ap:Quotation ;
    ap:id d:quote-gauss-equivalence ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-28 ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Ch. 28, p. 83" ;
    ap:body "All Gaussian co-ordinate systems are essentially equivalent for the formulation of the general laws of nature." ;
    ap:bodyLanguage "en" ; ap:emphasis "original" ; ap:omissionsPresent false .

d:quote-incompatibility-resolved a ap:Quotation ;
    ap:id d:quote-incompatibility-resolved ; ap:paper d:paper-relativity-1920 ;
    ap:section d:section-ch-07 ; ap:quotesFrom d:work-relativity-de-1916 ;
    ap:locator "Ch. 7, p. 21" ;
    ap:body "in really there is not the least incompatibilitiy between the principle of relativity and the law of propagation of light" ;
    ap:bodyLanguage "en" ; ap:emphasis "original" ; ap:omissionsPresent false .

