    ap:rationale "Faraday-Maxwell field formulation of electromagnetism establishes the no-action-at-a-distance background that SR completes." .

d:citation-newton a ap:Citation ;
    ap:id d:citation-newton ; ap:paper d:paper-relativity-1920 ;
    ap:citingSection d:section-ch-29 ;
    ap:citedWork d:work-newton-principia ; ap:kind "extends" ;
