# AE-relativity.ttl  —  full-coverage fixture (pass 2)
#
# Comprehensive RDF fixture for static/schemas/scientific-paper-cwa-shacl-rev2.ttl
# (Layer B), modelling the 1920 English-translation publication of Einstein's
# "Relativity: The Special and General Theory" (Robert W. Lawson, trans.;
# Methuen & Co Ltd). Source PDF at static/fixtures/AE-relativity.pdf.
#
# This file is the second-pass full-mapping replacement of the earlier sample
# fixture: every chapter (1–32, plus preface), every appendix that survives in
# the source (I–IV; V is excluded by copyright per the front matter), every
# illustrated figure (1, 2, 3, 4, 05), the eclipse-results table from App III,
# every named theorist or experimentalist cited by name, and a representative
# selection of equations and quotations spanning all three parts.
#
# Layer A (ex:PersonShape, fabio:Journal, etc.) is intentionally not exercised:
# its bibliographic posture demands ORCIDs, which neither author had (Einstein
# d. 1955; Lawson d. 1960; ORCID launched 2012). Per PALS's LAW the absence is
# declared, not silently filled with fabricated identifiers.
#
# Generated by Claude Opus 4.7 on 2026-05-10. Per PALS's LAW: factual
# attributions to historical figures (birth/death years, primary affiliations,
# CRediT-style contribution roles attributed retroactively) are encoded as
# best-effort schema fixtures, not authoritative biographical claims.

@prefix ap:   <https://example.org/academic-paper/> .
@prefix d:    <https://example.org/data/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =========================================================================
# Paper — the 1920 English-translation publication record
# =========================================================================
d:paper-relativity-1920 a ap:Paper ;
    ap:id              d:paper-relativity-1920 ;
    ap:title           "Relativity: The Special and General Theory" ;
    ap:abstract        "Popular exposition of the special and general theories of relativity for readers without the mathematical apparatus of theoretical physics. Three parts (Special Theory, chapters 1-17; General Theory, chapters 18-29; Considerations on the Universe as a Whole, chapters 30-32) plus four surviving appendices (Lorentz-transformation derivation; Minkowski 4D space; Experimental confirmation of GR via Mercury perihelion, 1919 eclipse, and gravitational redshift; Updates on cosmological structure including Friedman expanding space and Hubble redshift). The author treats the empirical foundations of the theory in a 'step-motherly' fashion to keep conceptual exposition primary." ;
    ap:language        "en" ;
    ap:epistemicMethod "theoretical" ;
    ap:format          "monograph" ;
    ap:publisher       "Methuen & Co Ltd" ;
    ap:year            1920 ;
    ap:license         <https://www.gnu.org/licenses/fdl.txt> ;
    ap:pageCount       115 ;
    ap:keywords        "relativity", "special relativity", "general relativity",
                       "Lorentz transformation", "space-time", "gravitation",
                       "equivalence principle", "Minkowski space",
                       "principle of relativity", "constancy of light",
                       "perihelion of Mercury", "gravitational deflection of light",
                       "gravitational redshift", "cosmology", "expanding universe",
                       "non-Euclidean geometry", "reference frame", "simultaneity",
                       "mass-energy equivalence", "popular science" .

