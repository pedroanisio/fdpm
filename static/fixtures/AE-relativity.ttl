# =========================================================================
# Definitions — paper-internal
# =========================================================================
d:defn-relativity a ap:Definition ;
    ap:id d:defn-relativity ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-relativity-principle ; ap:section d:section-ch-05 ;
    ap:body "If, relative to K, K' is a uniformly moving co-ordinate system devoid of rotation, then natural phenomena run their course with respect to K' according to exactly the same general laws as with respect to K." ;
    ap:provenance "stipulated" .

d:defn-simultaneity a ap:Definition ;
    ap:id d:defn-simultaneity ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-simultaneity ; ap:section d:section-ch-09 ;
    ap:body "Two events that are simultaneous with respect to one inertial reference-frame are not in general simultaneous with respect to another inertial reference-frame in motion relative to the first." ;
    ap:provenance "derived" .

d:defn-equivalence a ap:Definition ;
    ap:id d:defn-equivalence ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-equivalence ; ap:section d:section-ch-20 ;
    ap:body "An observer in a uniformly accelerated reference-body cannot, by any local mechanical experiment, distinguish the resulting forces from those due to a uniform gravitational field; gravitational and inertial mass are equal." ;
    ap:provenance "stipulated" .

d:defn-mass-energy a ap:Definition ;
    ap:id d:defn-mass-energy ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-mass-energy ; ap:section d:section-ch-15 ;
    ap:body "If a body absorbs an amount of energy E0, its inertial mass increases by E0/c²; the inertial mass of a system is a measure of its energy. Hence E = mc²." ;
    ap:provenance "derived" .

d:defn-general-relativity a ap:Definition ;
    ap:id d:defn-general-relativity ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-general-relativity-principle ; ap:section d:section-ch-28 ;
    ap:body "All Gaussian co-ordinate systems are essentially equivalent for the formulation of the general laws of nature." ;
    ap:provenance "stipulated" .

d:defn-aether a ap:Definition ;
    ap:id d:defn-aether ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-aether ; ap:section d:section-ch-16 ;
    ap:body "The aether was the hypothetical medium relative to which the Lorentz-Maxwell electrodynamic equations were thought to be exactly valid; on the basis of the theory of relativity, no such 'specially favoured' co-ordinate system exists, and there can be no aether-drift." ;
    ap:provenance "borrowed" ; ap:citedFrom d:work-lorentz-electrons .

d:defn-finite-unbounded a ap:Definition ;
    ap:id d:defn-finite-unbounded ; ap:paper d:paper-relativity-1920 ;
    ap:concept d:concept-finite-unbounded ; ap:section d:section-ch-31 ;
    ap:body "A spherical (or elliptical) three-dimensional space whose 'world-radius' R is finite, possessing finite volume but no boundary; analogous to the surface of a sphere in two dimensions." ;
    ap:provenance "borrowed" ; ap:citedFrom d:work-relativity-de-1916 .

# =========================================================================
# Theorists — every named historical figure invoked in the text
# =========================================================================
