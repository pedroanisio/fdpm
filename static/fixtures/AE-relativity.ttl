# =========================================================================
# Theories
# =========================================================================
d:theory-sr a ap:Theory ;
    ap:id d:theory-sr ; ap:name "Special Theory of Relativity" ;
    ap:summary "Theory uniting the principle of relativity (in the restricted sense) with the constancy of c, yielding the Lorentz transformation as the law relating space-time coordinates between inertial frames. Predicts time dilation, length contraction, the relativistic velocity-addition law, and the mass-energy equivalence E=mc²." .

d:theory-gr a ap:Theory ;
    ap:id d:theory-gr ; ap:name "General Theory of Relativity" ;
    ap:summary "Extension of special relativity to non-inertial reference frames and gravitation. Treats gravity as the geometric structure of a non-Euclidean space-time continuum; the equivalence principle (inertial = gravitational mass) is the bridge from SR to GR." ;
    ap:extendsTheory d:theory-sr .

d:theory-maxwell-lorentz a ap:Theory ;
    ap:id d:theory-maxwell-lorentz ; ap:name "Maxwell-Lorentz electrodynamics" ;
    ap:summary "Pre-relativistic electromagnetic theory whose constancy-of-light consequence drove the relativistic re-derivation; SR contains it as a limiting/co-variant case." ;
    ap:primaryTheorist d:theorist-lorentz .

d:theory-newton-kepler a ap:Theory ;
    ap:id d:theory-newton-kepler ; ap:name "Newton-Kepler gravitation" ;
    ap:summary "Classical inverse-square gravitation; recovered from GR as a first approximation in weak fields and at non-relativistic velocities." ;
    ap:primaryTheorist d:theorist-newton .

d:theory-friedman-cosmology a ap:Theory ;
    ap:id d:theory-friedman-cosmology ; ap:name "Friedman expanding-space cosmology" ;
    ap:summary "Cosmological solutions to the GR field equations in which the world-radius depends on time, eliminating the need for the cosmological term and predicting an expanding universe." ;
    ap:primaryTheorist d:theorist-friedman ;
    ap:extendsTheory d:theory-gr .

# =========================================================================
# Method — single high-level method (axiomatic-deductive)
# =========================================================================
d:method-axiomatic a ap:Method ;
    ap:id d:method-axiomatic ; ap:paper d:paper-relativity-1920 ;
    ap:name "axiomatic-deductive exposition with thought-experiments" ;
    ap:kind "theoretical" ;
    ap:procedure "Take the principle of relativity and the constancy of c as postulates. Use thought-experiments (railway carriage and embankment, lightning strikes A and B, accelerated chest, rotating disc, marble slab, chest in space) to surface the conceptual content. Derive the Lorentz transformation; from the Lorentz transformation, derive time dilation, length contraction, the relativistic velocity-addition law, and the mass-energy relation. For GR, take the equivalence of inertial and gravitational mass as the new postulate; introduce Gaussian co-ordinates and the 'reference-mollusc' formulation; derive light deflection, perihelion precession, and gravitational redshift as the three principal observational tests." .

# =========================================================================
# Findings — observational confirmations of the theory
# =========================================================================
d:finding-fizeau a ap:Finding ;
    ap:id d:finding-fizeau ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-13 ;
    ap:statement "Fizeau's measured velocity of light in moving water matches the relativistic velocity-addition formula (B) to within ~1% per Zeeman's measurements, providing a crucial empirical test of the special theory." .

d:finding-michelson-morley a ap:Finding ;
    ap:id d:finding-michelson-morley ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-16 ;
    ap:statement "Michelson-Morley's null result for an aether-drift, originally rescued by the FitzGerald-Lorentz contraction hypothesis, follows naturally from SR without auxiliary hypotheses." .

d:finding-mercury a ap:Finding ;
    ap:id d:finding-mercury ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:statement "GR predicts the perihelion of Mercury advances by 43 seconds of arc per century (after subtracting Newtonian planetary perturbations), in strict agreement with the observed residual established by Le Verrier (1859) and Newcomb (1895)." .

d:finding-eclipse-1919 a ap:Finding ;
    ap:id d:finding-eclipse-1919 ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:statement "Joint Royal Society / Royal Astronomical Society expeditions to Sobral (Brazil) and Príncipe (West Africa) measured the predicted ~1.7 seconds of arc grazing-incidence light deflection during the 29 May 1919 total solar eclipse." .

d:finding-grav-redshift a ap:Finding ;
    ap:id d:finding-grav-redshift ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:statement "Adams (1924) measured the gravitational redshift in spectral lines of the dense companion of Sirius (~30× the predicted solar redshift), establishing the third classical test of GR; earlier solar measurements (Grebe-Bachem, Evershed) were ambiguous against St. John's negative results." .

d:finding-hubble-expansion a ap:Finding ;
    ap:id d:finding-hubble-expansion ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iv ;
    ap:statement "Hubble's distance-redshift relation in extra-galactic nebulae is consistent with Friedman's expanding-space solution to the GR field equations." .

# =========================================================================
# Limitations
# =========================================================================
d:limit-empirical-treatment a ap:Limitation ;
    ap:id d:limit-empirical-treatment ; ap:paper d:paper-relativity-1920 ;
    ap:statement "The author has 'purposely treated the empirical physical foundations of the theory in a step-motherly fashion' (Preface), prioritising conceptual clarity. Readers seeking detailed experimental coverage will need primary sources." ;
    ap:scope "empirical" .

d:limit-app-v-copyright a ap:Limitation ;
    ap:id d:limit-app-v-copyright ; ap:paper d:paper-relativity-1920 ;
    ap:statement "Appendix V ('Relativity and the Problem of Space') is referenced in the table of contents but excluded from this digitisation under copyright restrictions: 'The fifth appendix was added by Einstein at the time of the fifteenth re-printing of this book; and as a result is still under copyright restrictions so cannot be added without the permission of the publisher.' (front matter, p. 4)." ;
    ap:scope "applicability" .

d:limit-redshift-1920 a ap:Limitation ;
    ap:id d:limit-redshift-1920 ; ap:paper d:paper-relativity-1920 ;
    ap:statement "At the time of writing (1920), the gravitational redshift was 'an open question'. Solar measurements were too small to be unambiguous (Grebe-Bachem and Evershed claimed confirmation; St. John dissented). Adams's confirmation via the Sirius companion came only in 1924 and is recorded as a translator's footnote." ;
    ap:scope "empirical" .

d:limit-hubble-incongruity a ap:Limitation ;
    ap:id d:limit-hubble-incongruity ; ap:paper d:paper-relativity-1920 ;
    ap:statement "Hubble's redshift-as-expansion implies a ~10⁹-year age for the expansion, while astrophysics suggests stellar systems take considerably longer to develop. 'It is in no way known how this incongruity is to be overcome.' (App. IV, p. 115)" ;
    ap:scope "interpretive" .

# =========================================================================
# Footnotes — selected representative footnotes from across the book
# =========================================================================
d:note-times-square a ap:Footnote ;
    ap:id d:note-times-square ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-02 ;
    ap:label "[A]" ;
    ap:body "Translator/janitor note: Einstein used 'Potsdamer Platz, Berlin' in the original; in the authorised translation Lawson supplemented this with 'Trafalgar Square, London'; the transcribers further changed it to 'Times Square, New York' as the most well-known/identifiable location to English speakers in the present day." ;
    ap:language "en" .

d:note-fizeau-formula a ap:Footnote ;
    ap:id d:note-fizeau-formula ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-13 ;
    ap:label "1" ;
    ap:body "Fizeau found W = w + v(1 - 1/n²), where n = c/w is the index of refraction of the liquid. To first order in vw/c², equation (B) reduces to Fizeau's result." ;
    ap:language "en" .

d:note-emc2 a ap:Footnote ;
    ap:id d:note-emc2 ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-15 ;
    ap:label "[Note]" ;
    ap:body "The equation E = mc² has been thoroughly proved time and again since this time (1920)." ;
    ap:language "en" .

d:note-electron-grav a ap:Footnote ;
    ap:id d:note-electron-grav ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-16 ;
    ap:label "1" ;
    ap:body "The general theory of relativity renders it likely that the electrical masses of an electron are held together by gravitational forces." ;
    ap:language "en" .

d:note-eclipse-1919 a ap:Footnote ;
    ap:id d:note-eclipse-1919 ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-22 ;
    ap:label "1" ;
    ap:body "By means of the star photographs of two expeditions equipped by a Joint Committee of the Royal and Royal Astronomical Societies, the existence of the deflection of light demanded by theory was first confirmed during the solar eclipse of 29th May, 1919. (Cf. Appendix III.)" ;
    ap:language "en" .

d:note-adams-sirius a ap:Footnote ;
    ap:id d:note-adams-sirius ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:label "[A]" ;
    ap:body "The displacement of spectral lines towards the red end of the spectrum was definitely established by Adams in 1924, by observations on the dense companion of Sirius, for which the effect is about thirty times greater than for the Sun. R.W.L. — translator." ;
    ap:language "en" .

d:note-mercury-venus a ap:Footnote ;
    ap:id d:note-mercury-venus ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:label "1" ;
    ap:body "Especially since the next planet Venus has an orbit that is almost an exact circle, which makes it more difficult to locate the perihelion with precision." ;
    ap:language "en" .

# =========================================================================
# Figures — every illustration in the source PDF
# =========================================================================
d:fig-train-embankment a ap:Figure ;
    ap:id d:fig-train-embankment ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-09 ;
    ap:label "Fig. 1" ;
    ap:caption "Train of velocity v moving along the embankment with mid-points M (embankment) and M' (train); points A and B mark the lightning strikes used to derive the relativity of simultaneity." ;
    ap:captionLanguage "en" ; ap:page 25 ;
    ap:altText "Horizontal line representing the embankment with points A, M, B labelled left to right; above the line a moving train with point M' between it, and arrows labelled v indicating the direction of motion." .

d:fig-k-frames a ap:Figure ;
    ap:id d:fig-k-frames ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-11 ;
    ap:label "Fig. 2" ;
    ap:caption "Two Cartesian co-ordinate systems K (axes x, y, z) and K' (axes x', y', z') with K' translating along the x-axis with velocity v relative to K; used to set up the Lorentz transformation." ;
    ap:captionLanguage "en" ; ap:page 31 ;
    ap:altText "Two right-handed coordinate axis triads side by side, the second offset to the right with arrows v indicating relative motion along x." .

d:fig-fizeau-tube a ap:Figure ;
    ap:id d:fig-fizeau-tube ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-13 ;
    ap:label "Fig. 3" ;
    ap:caption "Schematic of the Fizeau apparatus: a tube T through which liquid flows with velocity v; light propagates along the tube." ;
    ap:captionLanguage "en" ; ap:page 39 ;
    ap:altText "Two horizontal lines representing the walls of a tube T, with an arrow labelled v inside indicating the direction of liquid flow." .

d:fig-gauss-curves a ap:Figure ;
    ap:id d:fig-gauss-curves ; ap:paper d:paper-relativity-1920 ; ap:section d:section-ch-25 ;
    ap:label "Fig. 4" ;
    ap:caption "Schematic of u-curves (u = 1, 2, 3) and v-curves (v = 1, 2, 3) on the surface of a marble slab, illustrating Gaussian co-ordinates; point P has Gaussian coordinates (u=3, v=1)." ;
    ap:captionLanguage "en" ; ap:page 75 ;
    ap:altText "Mesh of intersecting curved lines on a flat surface, with three labelled u-curves and three labelled v-curves; a single point P marked at one intersection." .

d:fig-eclipse-deflection a ap:Figure ;
    ap:id d:fig-eclipse-deflection ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:label "Fig. 05" ;
    ap:caption "Geometry of solar light deflection: star at apparent position D1 in absence of the sun appears displaced to D2 due to gravitational deflection of light by the sun S; angle Δ marks the displacement." ;
    ap:captionLanguage "en" ; ap:page 109 ;
    ap:altText "Diagram showing the sun S as a small disc; dashed lines from D1 (apparent position) and D2 (observed position) converging near S, with angle Δ between them." .

# =========================================================================
# Table — eclipse-measurement table from Appendix III
# =========================================================================
d:table-eclipse-stars a ap:Table ;
    ap:id d:table-eclipse-stars ; ap:paper d:paper-relativity-1920 ; ap:section d:section-app-iii ;
    ap:label "Table — Eclipse star deflections" ;
    ap:caption "Rectangular components (in seconds of arc) of the observed and calculated deviations of seven stars from the 29 May 1919 eclipse measurements; first co-ordinate observed/calculated and second co-ordinate observed/calculated; star numbers 11, 5, 4, 3, 6, 10, 2." ;
    ap:captionLanguage "en" ; ap:page 110 ;
    ap:altText "Tabular layout with star number column and four numeric columns (observed and calculated for each of two co-ordinates), seven data rows." ;
    ap:rowCount 8 ; ap:columnCount 5 ; ap:headerRows 2 .
