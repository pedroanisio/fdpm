# scientific-paper-cwa-shacl-rev3.ttl  —  v0.4.0-aligned full SHACL counterpart
#
# This file is the SHACL/CWA mirror of static/schemas/academic-paper.ts (v0.4.0).
# Two layers:
#
#   LAYER A — Bibliographic identity (SPAR/FRBR vocabulary).
#     The original CWA shapes recovered from the pyshacl trace at
#     static/tmp/shacl.txt. Targets fabio:Work, frbr:Expression,
#     fabio:JournalArticle, foaf:Person, fabio:Journal, foaf:Organization,
#     frapo:Project, plus reified DOI/ORCID/ISSN identifiers with ISO
#     checksum SPARQL. Bug fixes vs. the recovered version are noted
#     inline as [BUGFIX].
#
#   LAYER B — Analytical content (ex: vocabulary).
#     Mirrors the 24 FDPM primitives in academic-paper.ts (Paper, Author,
#     Affiliation, Section, Claim, Evidence, Quotation, Work, Concept,
#     Definition, Theorist, Theory, Method, Finding, Limitation,
#     Footnote, Equation, Figure, Citation, Funding, Funder, Table,
#     PaperRelation, Erratum), every primitive-level refine, every
#     Refined-root invariant, all 7 cycle checks, and the 5
#     epistemicMethod-driven kind-conditional rules.
#
# Property paths in Layer B use the ex: namespace because the FDPM
# primitive set is local to this project. The two layers can validate
# the same data graph without conflict: a workbook RDF instance carries
# both fabio:JournalArticle (LAYER A focus) and ex:Paper (LAYER B focus)
# rdf:types when fully serialized.
#
# Changes vs rev2 (v0.3.1 → v0.4.0):
#   - NEW primitive ap:Erratum (B.24): id, paper, kind, title, body,
#     issuedDate, noticeDoi, correctsSection, correctsClaim,
#     correctsFinding, correctsEquation. New ap:ErratumIdShape in A.0.
#   - ap:ClaimShape extended with lifecycleStatus (enum) and
#     supersededBy (Claim FK).
#   - ap:FindingShape extended with testsHypothesis (Claim FK) and
#     outcome (enum).
#   - PaperShape gains 4 SPARQL invariants (B.99.13–B.99.16):
#     supersededBy resolution + no-self-loop, testsHypothesis points
#     to hypothesis-kind Claim, hypothesis-Finding closure for
#     empirical papers, Erratum corrects* ref-integrity.
#   - Drift fixes (TTL now matches Zod):
#       * Author.email regex tightened (no leading dot, no consecutive dots).
#       * Work.url pattern requires a host.
#       * Paper.license dropped the IRI branch; SPDX literal only.
#       * Confidence.score accepts xsd:decimal OR xsd:double
#         (JSON-LD round-trip emits xsd:double for JS numbers).
#       * Funder.registryId: hard pattern error preserved; absence
#         now emits a separate sh:Warning sh:sparql so the warning
#         fires on the same condition as the Zod paper-coherence walker.
#   - Added owl:versionInfo on the ontology resource so version drift
#     is machine-detectable.
#
# Generated by Claude Opus 4.7 on 2026-05-11. Per PALS's LAW: this output
# is unverified; round-trip through pyshacl against representative
# fixtures (positive + negative cases per primitive) before treating as
# canonical.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .

@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .

# SPAR ontologies
@prefix fabio:    <http://purl.org/spar/fabio/> .
@prefix frbr:     <http://purl.org/vocab/frbr/core#> .
@prefix cito:     <http://purl.org/spar/cito/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix literal:  <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix pro:      <http://purl.org/spar/pro/> .
@prefix scoro:    <http://purl.org/spar/scoro/> .                # [BUGFIX] was http://purl.org/cerif/frapo/
@prefix prism:    <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix frapo:    <http://purl.org/cerif/frapo/> .
@prefix po:       <http://www.essepuntato.it/2008/12/pattern#> .
@prefix doco:     <http://purl.org/spar/doco/> .
@prefix deo:      <http://purl.org/spar/deo/> .

@prefix ex:       <https://example.org/shapes/> .
@prefix ap:       <https://example.org/academic-paper/> .

# ============================================================================
# Ontology header — version metadata (rev3 / v0.4.0)
# ============================================================================

<https://example.org/academic-paper/shapes>
    a owl:Ontology ;
    owl:versionInfo "0.4.0" ;
    rdfs:label "FDPM academic-paper SHACL shapes (rev3)" ;
    rdfs:comment "SHACL/CWA mirror of static/schemas/academic-paper.ts v0.4.0. The semver tag is the source-of-truth for cross-file drift detection." .

# ============================================================================
# LAYER A.0  —  Common ID patterns (sh:NodeShape per primitive ID prefix)
#
# Mirrors academic-paper.ts §3 ID schemas (PaperIdSchema, AuthorIdSchema, …).
# Each shape both targets its class AND requires the IRI's local-name fragment
# to match the kebab-prefixed regex.
# ============================================================================

ap:PaperIdShape         a sh:NodeShape ; sh:targetClass ap:Paper ;
    sh:nodeKind sh:IRI ; sh:pattern "paper-[a-z0-9-]+$" .

ap:AuthorIdShape        a sh:NodeShape ; sh:targetClass ap:Author ;
    sh:nodeKind sh:IRI ; sh:pattern "author-[a-z0-9-]+$" .

ap:AffiliationIdShape   a sh:NodeShape ; sh:targetClass ap:Affiliation ;
    sh:nodeKind sh:IRI ; sh:pattern "affil-[a-z0-9-]+$" .

ap:SectionIdShape       a sh:NodeShape ; sh:targetClass ap:Section ;
    sh:nodeKind sh:IRI ; sh:pattern "section-[a-z0-9-]+$" .

ap:ClaimIdShape         a sh:NodeShape ; sh:targetClass ap:Claim ;
    sh:nodeKind sh:IRI ; sh:pattern "claim-[a-z0-9-]+$" .

ap:EvidenceIdShape      a sh:NodeShape ; sh:targetClass ap:Evidence ;
    sh:nodeKind sh:IRI ; sh:pattern "evidence-[a-z0-9-]+$" .

ap:QuotationIdShape     a sh:NodeShape ; sh:targetClass ap:Quotation ;
    sh:nodeKind sh:IRI ; sh:pattern "quote-[a-z0-9-]+$" .

ap:WorkIdShape          a sh:NodeShape ; sh:targetClass ap:Work ;
    sh:nodeKind sh:IRI ; sh:pattern "work-[a-z0-9-]+$" .

ap:ConceptIdShape       a sh:NodeShape ; sh:targetClass ap:Concept ;
    sh:nodeKind sh:IRI ; sh:pattern "concept-[a-z0-9-]+$" .

ap:DefinitionIdShape    a sh:NodeShape ; sh:targetClass ap:Definition ;
    sh:nodeKind sh:IRI ; sh:pattern "defn-[a-z0-9-]+$" .

ap:TheoristIdShape      a sh:NodeShape ; sh:targetClass ap:Theorist ;
    sh:nodeKind sh:IRI ; sh:pattern "theorist-[a-z0-9-]+$" .

ap:TheoryIdShape        a sh:NodeShape ; sh:targetClass ap:Theory ;
    sh:nodeKind sh:IRI ; sh:pattern "theory-[a-z0-9-]+$" .

ap:MethodIdShape        a sh:NodeShape ; sh:targetClass ap:Method ;
    sh:nodeKind sh:IRI ; sh:pattern "method-[a-z0-9-]+$" .

ap:FindingIdShape       a sh:NodeShape ; sh:targetClass ap:Finding ;
    sh:nodeKind sh:IRI ; sh:pattern "finding-[a-z0-9-]+$" .

ap:LimitationIdShape    a sh:NodeShape ; sh:targetClass ap:Limitation ;
    sh:nodeKind sh:IRI ; sh:pattern "limit-[a-z0-9-]+$" .

ap:FootnoteIdShape      a sh:NodeShape ; sh:targetClass ap:Footnote ;
    sh:nodeKind sh:IRI ; sh:pattern "note-[a-z0-9-]+$" .

ap:EquationIdShape      a sh:NodeShape ; sh:targetClass ap:Equation ;
    sh:nodeKind sh:IRI ; sh:pattern "eq-[a-z0-9-]+$" .

ap:FigureIdShape        a sh:NodeShape ; sh:targetClass ap:Figure ;
    sh:nodeKind sh:IRI ; sh:pattern "fig-[a-z0-9-]+$" .

ap:CitationIdShape      a sh:NodeShape ; sh:targetClass ap:Citation ;
    sh:nodeKind sh:IRI ; sh:pattern "citation-[a-z0-9-]+$" .

ap:FundingIdShape       a sh:NodeShape ; sh:targetClass ap:Funding ;
    sh:nodeKind sh:IRI ; sh:pattern "funding-[a-z0-9-]+$" .

ap:FunderIdShape        a sh:NodeShape ; sh:targetClass ap:Funder ;
    sh:nodeKind sh:IRI ; sh:pattern "funder-[a-z0-9-]+$" .

ap:TableIdShape         a sh:NodeShape ; sh:targetClass ap:Table ;
    sh:nodeKind sh:IRI ; sh:pattern "table-[a-z0-9-]+$" .

ap:PaperRelationIdShape a sh:NodeShape ; sh:targetClass ap:PaperRelation ;
    sh:nodeKind sh:IRI ; sh:pattern "prel-[a-z0-9-]+$" .

ap:ErratumIdShape       a sh:NodeShape ; sh:targetClass ap:Erratum ;
    sh:nodeKind sh:IRI ; sh:pattern "erratum-[a-z0-9-]+$" .

# ============================================================================
# LAYER A.1  —  WorkShape  (fabio:Work)
# ============================================================================

ex:WorkShape
    a sh:NodeShape ;
    sh:targetClass fabio:Work ;

    sh:property [
        sh:path     dcterms:subject ;
        sh:name     "subjects/keywords (≥ 3, literal or skos:Concept)" ;
        sh:minCount 3 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:class    skos:Concept ]
        ) ;
    ] ;

    sh:property [
        sh:path     pro:isDocumentContextFor ;
        sh:name     "author roles (≥ 1)" ;
        sh:minCount 1 ;
        sh:node     ex:AuthorRoleShape ;
    ] ;

    sh:property [
        sh:path  frapo:isOutputOf ;
        sh:name  "funded project (0..N)" ;
        sh:class frapo:Project ;
    ] .

# ============================================================================
# LAYER A.2  —  ExpressionShape  (frbr:Expression)
# [BUGFIX] targetClass changed from fabio:Expression (which does not exist
# in FaBiO) to frbr:Expression.
# ============================================================================

ex:ExpressionShape
    a sh:NodeShape ;
    sh:targetClass frbr:Expression ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path      dcterms:title ;
        sh:name      "title" ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
    ] ;

    sh:property [
        sh:path     dcterms:abstract ;
        sh:name     "abstract" ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
    ] ;

    sh:property [
        sh:path     datacite:hasIdentifier ;
        sh:name     "DOI (reified)" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     ex:DoiShape ;
    ] ;

    sh:property [
        sh:path     frbr:partOf ;
        sh:name     "container journal" ;
        sh:maxCount 1 ;
        sh:class    fabio:Journal ;
        sh:node     ex:JournalShape ;
    ] ;

    sh:property [
        sh:path     dcterms:language ;
        sh:name     "language (BCP-47)" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" ;
    ] ;

    sh:property [
        sh:path     dcterms:license ;
        sh:name     "license (IRI to a known license)" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:path     prism:publicationDate ;
        sh:name     "publication date" ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:gYear ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:dateTime ]
        ) ;
    ] ;

    sh:property [
        sh:path     cito:cites ;
        sh:name     "references (≥ 1)" ;
        sh:minCount 1 ;
    ] ;

    sh:property [
        sh:path     frbr:realizationOf ;
        sh:name     "realization" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    fabio:Work ;
        sh:node     ex:WorkShape ;
    ] ;

    # F6 — numeric pages must satisfy pageStart ≤ pageEnd.
    sh:sparql [
        sh:message "When both pages are purely numeric, bibo:pageStart must be ≤ bibo:pageEnd." ;
        sh:select  """
            PREFIX bibo: <http://purl.org/ontology/bibo/>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this bibo:pageStart ?s ; bibo:pageEnd ?e .
                FILTER (REGEX(STR(?s), "^[0-9]+$") && REGEX(STR(?e), "^[0-9]+$"))
                FILTER (xsd:integer(?s) > xsd:integer(?e))
            }
        """ ;
    ] ;

    # [BUGFIX] datatype guards — bibo pages are mixed alphanumeric (Roman
    # numerals, "iv", appendix labels). xsd:token is the pragmatic cross-
    # over of "single-line, no leading/trailing whitespace" without
    # rejecting non-numeric pagination. The SPARQL above only fires when
    # both sides match ^[0-9]+$, so token covers both cases.
    sh:property [ sh:path bibo:pageStart ; sh:maxCount 1 ; sh:datatype xsd:token ] ;
    sh:property [ sh:path bibo:pageEnd   ; sh:maxCount 1 ; sh:datatype xsd:token ] ;
    sh:property [ sh:path bibo:volume    ; sh:maxCount 1 ; sh:datatype xsd:token ] ;
    sh:property [ sh:path bibo:issue     ; sh:maxCount 1 ; sh:datatype xsd:token ] .

# ============================================================================
# LAYER A.3  —  PersonShape  (foaf:Person)  closed
# ============================================================================

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path     datacite:hasIdentifier ;
        sh:name     "ORCID (required)" ;
        sh:minCount 1 ;
        sh:node     ex:OrcidShape ;
    ] ;

    sh:property [ sh:path foaf:name        ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path foaf:givenName   ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path foaf:familyName  ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:identifier ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# ============================================================================
# LAYER A.4  —  AuthorRoleShape  (pro:RoleInTime reification)
# ============================================================================

ex:AuthorRoleShape
    a sh:NodeShape ;

    sh:property [
        sh:path     pro:withRole ;
        sh:name     "role kind" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( pro:author pro:editor scoro:corresponding-author ) ;
        sh:message  "Role must be pro:author, pro:editor, or scoro:corresponding-author." ;
    ] ;

    sh:property [
        sh:path     pro:isHeldBy ;
        sh:name     "person holding role" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node     ex:PersonShape ;
    ] ;

    sh:property [
        sh:path     po:hasNext ;
        sh:name     "next role in the byline chain" ;
        sh:maxCount 1 ;
    ] .

# ============================================================================
# LAYER A.5  —  DoiShape (closed) + ORCID/ISSN identifier shapes
# ============================================================================

ex:DoiShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path     literal:hasLiteralValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern  "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ;
        sh:message  "DOI literal must follow Crossref/DOI syntax 10.{4-9 digits}/{suffix}." ;
    ] ;

    sh:property [
        sh:path     datacite:usesIdentifierScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue datacite:doi ;
    ] .

ex:OrcidShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path     literal:hasLiteralValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern  "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ;
    ] ;
    sh:property [
        sh:path     datacite:usesIdentifierScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue datacite:orcid ;
    ] ;

    sh:sparql [
        sh:message "ORCID checksum invalid (ISO/IEC 7064 mod 11-2)." ;
        sh:select  """
            PREFIX datacite: <http://purl.org/spar/datacite/>
            PREFIX literal:  <http://www.essepuntato.it/2010/06/literalreification/>
            PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this datacite:usesIdentifierScheme datacite:orcid ;
                      literal:hasLiteralValue ?orcid .
                BIND(REPLACE(?orcid, "-", "") AS ?d)

                BIND(((0 + xsd:integer(SUBSTR(?d,1,1))) * 2) AS ?m1)
                BIND((((?m1  - (FLOOR(?m1/11)  * 11)) + xsd:integer(SUBSTR(?d,2,1)))  * 2) AS ?m2)
                BIND((((?m2  - (FLOOR(?m2/11)  * 11)) + xsd:integer(SUBSTR(?d,3,1)))  * 2) AS ?m3)
                BIND((((?m3  - (FLOOR(?m3/11)  * 11)) + xsd:integer(SUBSTR(?d,4,1)))  * 2) AS ?m4)
                BIND((((?m4  - (FLOOR(?m4/11)  * 11)) + xsd:integer(SUBSTR(?d,5,1)))  * 2) AS ?m5)
                BIND((((?m5  - (FLOOR(?m5/11)  * 11)) + xsd:integer(SUBSTR(?d,6,1)))  * 2) AS ?m6)
                BIND((((?m6  - (FLOOR(?m6/11)  * 11)) + xsd:integer(SUBSTR(?d,7,1)))  * 2) AS ?m7)
                BIND((((?m7  - (FLOOR(?m7/11)  * 11)) + xsd:integer(SUBSTR(?d,8,1)))  * 2) AS ?m8)
                BIND((((?m8  - (FLOOR(?m8/11)  * 11)) + xsd:integer(SUBSTR(?d,9,1)))  * 2) AS ?m9)
                BIND((((?m9  - (FLOOR(?m9/11)  * 11)) + xsd:integer(SUBSTR(?d,10,1))) * 2) AS ?m10)
                BIND((((?m10 - (FLOOR(?m10/11) * 11)) + xsd:integer(SUBSTR(?d,11,1))) * 2) AS ?m11)
                BIND((((?m11 - (FLOOR(?m11/11) * 11)) + xsd:integer(SUBSTR(?d,12,1))) * 2) AS ?m12)
                BIND((((?m12 - (FLOOR(?m12/11) * 11)) + xsd:integer(SUBSTR(?d,13,1))) * 2) AS ?m13)
                BIND((((?m13 - (FLOOR(?m13/11) * 11)) + xsd:integer(SUBSTR(?d,14,1))) * 2) AS ?m14)
                BIND((((?m14 - (FLOOR(?m14/11) * 11)) + xsd:integer(SUBSTR(?d,15,1))) * 2) AS ?m15)

                BIND((?m15 - (FLOOR(?m15/11) * 11)) AS ?m15Mod)
                BIND((12 - ?m15Mod) AS ?raw)
                BIND((?raw - (FLOOR(?raw/11) * 11)) AS ?expectedNum)
                BIND(IF(?expectedNum = 10, "X", STR(?expectedNum)) AS ?expected)
                BIND(SUBSTR(?d, 16, 1) AS ?actual)
                FILTER(?actual != ?expected)
            }
        """ ;
    ] .

ex:IssnShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path     literal:hasLiteralValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern  "^\\d{4}-\\d{3}[\\dX]$" ;
    ] ;
    sh:property [
        sh:path     datacite:usesIdentifierScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue datacite:issn ;
    ] ;

    sh:sparql [
        sh:message "ISSN checksum invalid (ISO 3297)." ;
        sh:select  """
            PREFIX datacite: <http://purl.org/spar/datacite/>
            PREFIX literal:  <http://www.essepuntato.it/2010/06/literalreification/>
            PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this datacite:usesIdentifierScheme datacite:issn ;
                      literal:hasLiteralValue ?issn .
                BIND(REPLACE(?issn, "-", "") AS ?d)
                BIND(8 * xsd:integer(SUBSTR(?d, 1, 1)) +
                     7 * xsd:integer(SUBSTR(?d, 2, 1)) +
                     6 * xsd:integer(SUBSTR(?d, 3, 1)) +
                     5 * xsd:integer(SUBSTR(?d, 4, 1)) +
                     4 * xsd:integer(SUBSTR(?d, 5, 1)) +
                     3 * xsd:integer(SUBSTR(?d, 6, 1)) +
                     2 * xsd:integer(SUBSTR(?d, 7, 1))
                     AS ?sum)
                BIND((?sum - (FLOOR(?sum/11) * 11)) AS ?sumMod)
                BIND((11 - ?sumMod) AS ?raw)
                BIND((?raw - (FLOOR(?raw/11) * 11)) AS ?expectedNum)
                BIND(IF(?expectedNum = 10, "X", STR(?expectedNum)) AS ?expected)
                BIND(SUBSTR(?d, 8, 1) AS ?actual)
                FILTER(?actual != ?expected)
            }
        """ ;
    ] .

# ============================================================================
# LAYER A.6  —  JournalShape (closed) + OrganizationShape (closed) + ProjectShape
# ============================================================================

ex:JournalShape
    a sh:NodeShape ;
    sh:targetClass fabio:Journal ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path     datacite:hasIdentifier ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:node     ex:IssnShape ;
    ] ;
    sh:property [
        sh:path     dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

ex:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass foaf:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [ sh:path foaf:name          ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:identifier ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ex:ProjectShape
    a sh:NodeShape ;
    sh:targetClass frapo:Project ;

    sh:property [
        sh:path     frapo:hasFundingAgency ;
        sh:name     "funding agency (≥ 1)" ;
        sh:minCount 1 ;
        sh:class    foaf:Organization ;
        sh:node     ex:OrganizationShape ;
    ] .

# ============================================================================
# LAYER A.7  —  Uniqueness invariants (SPARQL)
# ============================================================================

ex:UniqueDoiShape
    a sh:NodeShape ;
    sh:targetClass fabio:JournalArticle ;

    sh:sparql [
        sh:message "Two distinct fabio:JournalArticle nodes share the same DOI." ;
        sh:select  """
            PREFIX datacite: <http://purl.org/spar/datacite/>
            PREFIX literal:  <http://www.essepuntato.it/2010/06/literalreification/>
            SELECT $this ?other ?doi WHERE {
                $this  datacite:hasIdentifier/literal:hasLiteralValue ?doi .
                ?other datacite:hasIdentifier/literal:hasLiteralValue ?doi .
                ?this_id  datacite:usesIdentifierScheme datacite:doi .
                $this datacite:hasIdentifier ?this_id .
                FILTER ($this != ?other)
            }
        """ ;
    ] .

ex:UniqueOrcidShape
    a sh:NodeShape ;
    sh:targetClass foaf:Person ;

    sh:sparql [
        sh:message "Two distinct foaf:Person nodes share the same ORCID." ;
        sh:select  """
            PREFIX datacite: <http://purl.org/spar/datacite/>
            PREFIX literal:  <http://www.essepuntato.it/2010/06/literalreification/>
            SELECT $this ?other ?orcid WHERE {
                $this  datacite:hasIdentifier/literal:hasLiteralValue ?orcid .
                ?other datacite:hasIdentifier/literal:hasLiteralValue ?orcid .
                ?this_id  datacite:usesIdentifierScheme datacite:orcid .
                $this datacite:hasIdentifier ?this_id .
                FILTER ($this != ?other)
            }
        """ ;
    ] .

# [BUGFIX] UniquePositionShape now targets fabio:Work and looks for two
# pro:RoleInTime contexts of the same Work that resolve to the same byline
# slot. Slot identity uses pro:relatesToDocument as the join key (a stable
# pointer to the Work the role attaches to) plus an explicit ordinal via
# ex:position. The previous version used po:hasNext as a position label,
# which is a linked-list pointer and cannot soundly carry positional
# identity (two roles legitimately point to the same "next" mid-chain).
ex:UniquePositionShape
    a sh:NodeShape ;
    sh:targetClass fabio:Work ;

    sh:sparql [
        sh:message "Two author roles on the same fabio:Work share the same ordinal byline position." ;
        sh:select  """
            PREFIX pro: <http://purl.org/spar/pro/>
            PREFIX ex:  <https://example.org/shapes/>
            SELECT $this ?r1 ?r2 ?pos WHERE {
                $this pro:isDocumentContextFor ?r1, ?r2 .
                ?r1 ex:ordinal ?pos .
                ?r2 ex:ordinal ?pos .
                FILTER (?r1 != ?r2)
            }
        """ ;
    ] .

# ============================================================================
# ============================================================================
# LAYER B  —  Analytical content shapes (mirror of academic-paper.ts)
#
# Conventions:
#   - Each TS primitive gets one ap:<Name>Shape NodeShape, sh:closed true,
#     sh:targetClass ap:<Name>.
#   - Cross-primitive ID references use sh:class to require the value to be
#     an instance of the FK'd class (so referential integrity is delegated
#     to RDF type assertions, the SHACL way of doing FKs).
#   - String length bounds:
#       ShortText  : minLength 1, maxLength 280
#       MediumText : minLength 1, maxLength 2000
#       LongText   : minLength 1, maxLength 20000
#   - Enum fields use sh:in over xsd:string literals.
#   - .refine() invariants from the TS file are encoded as sh:sparql node
#     constraints on the relevant shape (see Layer B.99).
# ============================================================================
# ============================================================================

# ---- B.1  Paper -----------------------------------------------------------

ap:PaperShape
    a sh:NodeShape ;
    sh:targetClass ap:Paper ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "paper-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:title    ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:subtitle ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:abstract ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 20000 ] ;
    sh:property [ sh:path ap:language ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[a-z]{2}$" ;
                  sh:message "language must be a 2-letter ISO 639-1 code (matches academic-paper.ts Iso639)." ] ;
    sh:property [ sh:path ap:epistemicMethod ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "empirical" "descriptive" "theoretical" "methodological"
                          "literary-critical" "review" "historical" ) ] ;
    sh:property [ sh:path ap:format ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "article" "essay" "monograph" "thesis" "chapter"
                          "letter" "editorial" "commentary" ) ] ;
    sh:property [ sh:path ap:venue     ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:publisher ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:year ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 2100 ] ;
    sh:property [ sh:path ap:publicationDate ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ;
    sh:property [ sh:path ap:version ; sh:maxCount 1 ;
                  sh:in ( "author-original" "submitted-manuscript-under-review"
                          "accepted-manuscript" "proof" "version-of-record"
                          "corrected-version-of-record" "enhanced-version-of-record" ) ] ;
    sh:property [ sh:path ap:doi ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] ;
    sh:property [ sh:path ap:isbn ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^(?:\\d[- ]?){9}[\\dX]$|^(?:\\d[- ]?){13}$" ] ;
    sh:property [ sh:path ap:license ; sh:maxCount 1 ;
                  sh:nodeKind sh:Literal ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 80 ;
                  sh:message "license must be a SPDX-style literal (1..80 chars). IRI branch removed in rev3 to mirror Zod (ShortText)." ] ;
    sh:property [ sh:path ap:pageCount ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:property [ sh:path ap:sourceDocument ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ] ;
    sh:property [ sh:path ap:keywords ; sh:maxCount 20 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ;
                  sh:message "keywords: array of ShortText, max 20 (matches academic-paper.ts)." ] .

# ---- B.2  Author ----------------------------------------------------------

ap:AuthorShape
    a sh:NodeShape ;
    sh:targetClass ap:Author ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "author-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:fullName   ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:familyName ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:givenNames ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:orcid ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ] ;
    sh:property [ sh:path ap:email ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  # Tightened in rev3 to match Zod `.email()` more closely:
                  # no leading dot, no consecutive dots, host must contain
                  # at least one dot, TLD ≥2 alpha. Java-regex compatible
                  # for pyshacl.
                  sh:pattern "^(?!\\.)(?!.*\\.\\.)[A-Za-z0-9._%+-]+@[A-Za-z0-9][A-Za-z0-9.-]*\\.[A-Za-z]{2,}$" ] ;
    sh:property [ sh:path ap:role ; sh:maxCount 1 ;
                  sh:in ( "lead" "co-author" "corresponding" "supervisor" "translator" ) ;
                  sh:defaultValue "co-author" ] ;
    sh:property [ sh:path ap:position ; sh:maxCount 1 ;
                  sh:in ( "first" "middle" "last" ) ] ;
    sh:property [ sh:path ap:affiliations ; sh:nodeKind sh:IRI ; sh:class ap:Affiliation ] ;
    sh:property [ sh:path ap:contributions ;
                  sh:in ( "conceptualization" "methodology" "software" "validation"
                          "formal-analysis" "investigation" "resources" "data-curation"
                          "writing-original-draft" "writing-review-editing"
                          "visualization" "supervision" "project-administration"
                          "funding-acquisition" ) ] .

# ---- B.3  Affiliation -----------------------------------------------------

ap:AffiliationShape
    a sh:NodeShape ;
    sh:targetClass ap:Affiliation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "affil-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:institution ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:department  ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:country ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[A-Z]{2}$" ;
                  sh:message "country must be ISO 3166-1 alpha-2." ] ;
    sh:property [ sh:path ap:rorId ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^https://ror\\.org/0[a-z0-9]{6}\\d{2}$" ] .

# ---- B.4  Section ---------------------------------------------------------

ap:SectionShape
    a sh:NodeShape ;
    sh:targetClass ap:Section ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "section-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:parent ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:title ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:order ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ap:role ; sh:maxCount 1 ;
                  sh:in ( "preface" "introduction" "body" "methods" "results"
                          "discussion" "conclusion" "appendix" "footnotes"
                          "bibliography" "other" ) ;
                  sh:defaultValue "body" ] ;
    sh:property [ sh:path ap:bodyText ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 20000 ] ;
    sh:property [ sh:path ap:language ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[a-z]{2}$" ] .

# ---- B.5  Claim -----------------------------------------------------------

ap:ClaimShape
    a sh:NodeShape ;
    sh:targetClass ap:Claim ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "claim-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "descriptive" "interpretive" "normative" "methodological"
                          "empirical" "definitional" "postulate" "hypothesis" ) ] ;
    sh:property [ sh:path ap:statement ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:derivesFrom ; sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    sh:property [ sh:path ap:counterReads ; sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    sh:property [ sh:path ap:confidence ; sh:maxCount 1 ; sh:node ap:ConfidenceShape ] ;

    # v0.4: Claim lifecycle status. Default 'asserted'; SHACL
    # consumers can read sh:defaultValue to fill in missing values.
    sh:property [ sh:path ap:lifecycleStatus ; sh:maxCount 1 ;
                  sh:in ( "asserted" "assumed" "proven" "refuted" "superseded" ) ;
                  sh:defaultValue "asserted" ] ;
    # v0.4: Optional FK to a Claim that supersedes this one. Resolution
    # and no-self-loop enforced on the Refined root (B.99.13).
    sh:property [ sh:path ap:supersededBy ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Claim ] .

# ---- B.6  Evidence --------------------------------------------------------

ap:EvidenceShape
    a sh:NodeShape ;
    sh:targetClass ap:Evidence ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "evidence-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:supports ; sh:minCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "data" "derivation" "citation" "observation" "exemplar"
                          "textual-passage" "thought-experiment" ) ] ;
    sh:property [ sh:path ap:summary ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:quotation ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Quotation ] ;
    sh:property [ sh:path ap:work ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;
    sh:property [ sh:path ap:locator ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 120 ] ;
    sh:property [ sh:path ap:provenance ; sh:node ap:ProvenanceShape ] .

# ---- B.7  Quotation -------------------------------------------------------

ap:QuotationShape
    a sh:NodeShape ;
    sh:targetClass ap:Quotation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "quote-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:quotesFrom ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;
    sh:property [ sh:path ap:locator ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 120 ] ;
    sh:property [ sh:path ap:body ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:bodyLanguage ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[a-z]{2}$" ] ;
    sh:property [ sh:path ap:emphasis ; sh:maxCount 1 ;
                  sh:in ( "none" "original" "added-by-citing-author" ) ;
                  sh:defaultValue "none" ] ;
    sh:property [ sh:path ap:omissionsPresent ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
                  sh:defaultValue false ] ;
    sh:property [ sh:path ap:translatedFrom ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Quotation ] ;

    # PALS's LAW: a body containing "[...]" must declare omissionsPresent=true.
    sh:sparql [
        sh:message "PALS's LAW: quotation containing '[...]' must set ap:omissionsPresent=true (omissions must be declared, never silent)." ;
        sh:select  """
            PREFIX ap:  <https://example.org/academic-paper/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this ap:body ?b .
                FILTER (CONTAINS(STR(?b), \"[...]\"))
                OPTIONAL { $this ap:omissionsPresent ?op }
                FILTER (!BOUND(?op) || ?op != true)
            }
        """ ;
    ] .

# ---- B.8  Work ------------------------------------------------------------

ap:WorkShape
    a sh:NodeShape ;
    sh:targetClass ap:Work ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "work-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "journal-article" "book" "book-chapter" "thesis" "report"
                          "preprint" "conference-paper" "newspaper-article"
                          "archival-document" "film" "audio-recording" "website"
                          "dataset" "software" "other" ) ] ;
    sh:property [ sh:path ap:title ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:authorsFreeText ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:year ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 2100 ] ;
    sh:property [ sh:path ap:venue     ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:publisher ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:doi  ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] ;
    sh:property [ sh:path ap:isbn ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^(?:\\d[- ]?){9}[\\dX]$|^(?:\\d[- ]?){13}$" ] ;
    sh:property [ sh:path ap:url  ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  # Tightened in rev3: require a non-empty host. Bare
                  # "http://" was accepted under the rev2 pattern but
                  # rejected by Zod `.url()`.
                  sh:pattern "^https?://[A-Za-z0-9._~%-]+(?::\\d{1,5})?(?:[/?#].*)?$" ] ;
    sh:property [ sh:path ap:language ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[a-z]{2}$" ] ;
    sh:property [ sh:path ap:translationOf ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;
    sh:property [ sh:path ap:editionOf ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;

    # No self-loops on translationOf / editionOf (cycle-of-length-1).
    sh:sparql [
        sh:message "Work cannot be a translation of itself (ap:translationOf)." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE { $this ap:translationOf $this . }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Work cannot be an edition of itself (ap:editionOf)." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE { $this ap:editionOf $this . }
        """ ;
    ] .

# ---- B.9  Concept ---------------------------------------------------------

ap:ConceptShape
    a sh:NodeShape ;
    sh:targetClass ap:Concept ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "concept-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:canonicalForm ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:domain ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:wikidataId ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^Q[1-9]\\d*$" ] ;
    sh:property [ sh:path ap:closeMatch ; sh:datatype xsd:string ; sh:pattern "^https?://" ] ;
    sh:property [ sh:path ap:borrowsFrom ; sh:nodeKind sh:IRI ; sh:class ap:Theorist ] ;
    sh:property [ sh:path ap:extends ; sh:nodeKind sh:IRI ; sh:class ap:Concept ] .

# ---- B.10  Definition -----------------------------------------------------

ap:DefinitionShape
    a sh:NodeShape ;
    sh:targetClass ap:Definition ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "defn-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:concept ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Concept ] ;
    sh:property [ sh:path ap:section ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:body ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:provenance ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "stipulated" "derived" "borrowed" ) ] ;
    sh:property [ sh:path ap:citedFrom ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;

    # provenance='borrowed' ⇒ citedFrom present.
    sh:sparql [
        sh:message "definition with provenance='borrowed' must reference a citedFrom Work." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:provenance \"borrowed\" .
                FILTER NOT EXISTS { $this ap:citedFrom ?w }
            }
        """ ;
    ] .

# ---- B.11  Theorist -------------------------------------------------------

ap:TheoristShape
    a sh:NodeShape ;
    sh:targetClass ap:Theorist ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "theorist-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:fullName   ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:familyName ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:birthYear ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 2100 ] ;
    sh:property [ sh:path ap:deathYear ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 2100 ] ;
    sh:property [ sh:path ap:primaryAffiliation ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:wikidataId ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^Q[1-9]\\d*$" ] ;
    sh:property [ sh:path ap:viafId ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^\\d+$" ] ;
    sh:property [ sh:path ap:notableTheories ; sh:nodeKind sh:IRI ; sh:class ap:Theory ] ;

    # deathYear ≥ birthYear (both optional; only fires when both bound).
    sh:sparql [
        sh:message "deathYear must be ≥ birthYear." ;
        sh:select  """
            PREFIX ap:  <https://example.org/academic-paper/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this ap:birthYear ?b ; ap:deathYear ?d .
                FILTER (xsd:integer(?d) < xsd:integer(?b))
            }
        """ ;
    ] .

# ---- B.12  Theory ---------------------------------------------------------

ap:TheoryShape
    a sh:NodeShape ;
    sh:targetClass ap:Theory ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "theory-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:name ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:summary ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:primaryTheorist ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Theorist ] ;
    sh:property [ sh:path ap:extendsTheory ; sh:nodeKind sh:IRI ; sh:class ap:Theory ] ;
    sh:property [ sh:path ap:respondsTo    ; sh:nodeKind sh:IRI ; sh:class ap:Theory ] .

# ---- B.13  Method ---------------------------------------------------------

ap:MethodShape
    a sh:NodeShape ;
    sh:targetClass ap:Method ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "method-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:name ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "qualitative" "quantitative" "mixed" "theoretical"
                          "literary" "historical" "computational" "experimental" ) ] ;
    sh:property [ sh:path ap:procedure ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 20000 ] .

# ---- B.14  Finding --------------------------------------------------------

ap:FindingShape
    a sh:NodeShape ;
    sh:targetClass ap:Finding ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "finding-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:statement ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:supportedBy ; sh:nodeKind sh:IRI ; sh:class ap:Evidence ] ;

    # v0.4: Empirical closure — optional pointer to the hypothesis
    # Claim this Finding tests. Ref-integrity (must point to a Claim
    # of kind='hypothesis') enforced on the Refined root (B.99.14).
    sh:property [ sh:path ap:testsHypothesis ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    # v0.4: Outcome of the Finding with respect to its hypothesis.
    sh:property [ sh:path ap:outcome ; sh:maxCount 1 ;
                  sh:in ( "supports" "refutes" "inconclusive" "partial" ) ] .

# ---- B.15  Limitation -----------------------------------------------------

ap:LimitationShape
    a sh:NodeShape ;
    sh:targetClass ap:Limitation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "limit-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:statement ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:scope ; sh:maxCount 1 ;
                  sh:in ( "methodological" "empirical" "interpretive" "applicability" ) ;
                  sh:defaultValue "applicability" ] .

# ---- B.16  Footnote -------------------------------------------------------

ap:FootnoteShape
    a sh:NodeShape ;
    sh:targetClass ap:Footnote ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "note-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:body ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:language ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[a-z]{2}$" ] .

# ---- B.17  Equation -------------------------------------------------------

ap:EquationShape
    a sh:NodeShape ;
    sh:targetClass ap:Equation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "eq-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:label ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:tex    ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:mathml ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 20000 ] ;
    sh:property [ sh:path ap:role ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "axiom" "postulate" "definition" "derived"
                          "empirical-law" "transformation" "identity" ) ] ;
    sh:property [ sh:path ap:derivesFrom    ; sh:nodeKind sh:IRI ; sh:class ap:Equation ] ;
    sh:property [ sh:path ap:fromPostulates ; sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    sh:property [ sh:path ap:doi ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] ;

    # Equation must have at least one of {tex, mathml}.
    sh:sparql [
        sh:message "Equation must have at least one of `tex` or `mathml`." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this ap:tex    ?t }
                FILTER NOT EXISTS { $this ap:mathml ?m }
            }
        """ ;
    ] .

# ---- B.18  Figure ---------------------------------------------------------

ap:FigureShape
    a sh:NodeShape ;
    sh:targetClass ap:Figure ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "fig-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:caption ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:captionLanguage ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[a-z]{2}$" ] ;
    sh:property [ sh:path ap:page ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:property [ sh:path ap:altText ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:imageRef ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ] ;
    sh:property [ sh:path ap:doi ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] .

# ---- B.19  Citation -------------------------------------------------------

ap:CitationShape
    a sh:NodeShape ;
    sh:targetClass ap:Citation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "citation-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:citingClaim   ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Claim ] ;
    sh:property [ sh:path ap:citingFinding ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Finding ] ;
    sh:property [ sh:path ap:citingSection ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:citingLocator ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 120 ] ;
    sh:property [ sh:path ap:citedWork ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;
    sh:property [ sh:path ap:citedQuotation ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Quotation ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "extends" "disagrees-with" "agrees-with" "confirms"
                          "refutes" "uses-method-of" "uses-data-of"
                          "obtains-background-from" "obtains-support-from"
                          "uses-conclusions-from" "qualifies" "reviews" "critiques"
                          "compiles" "supports" "cites-as-authority"
                          "cites-as-data-source" "cites-as-evidence"
                          "cites-as-related" "cites-for-information"
                          "replies-to" "updates" "retracts" ) ] ;
    sh:property [ sh:path ap:rationale ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] .

# ---- B.20  Funding --------------------------------------------------------

ap:FundingShape
    a sh:NodeShape ;
    sh:targetClass ap:Funding ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "funding-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:funder ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Funder ] ;
    sh:property [ sh:path ap:awardId    ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:awardTitle ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:recipients ; sh:nodeKind sh:IRI ; sh:class ap:Author ] .

# ---- B.21  Funder ---------------------------------------------------------

ap:FunderShape
    a sh:NodeShape ;
    sh:targetClass ap:Funder ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "funder-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:name ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    # rev3: pattern violation is a HARD error (was a warning in rev2,
    # which masked malformed IDs).
    sh:property [ sh:path ap:registryId ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^(?:https://ror\\.org/0[a-z0-9]{6}\\d{2}|10\\.13039/[0-9]+)$" ;
                  sh:message "registryId must be a ROR IRI or a Crossref Funder Registry DOI." ] ;

    # rev3: warning fires on ABSENCE, mirroring the Zod paper-coherence
    # walker. PALS's LAW posture: declare gaps, never hide them.
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "Funder.registryId is missing — declare a ROR or Crossref Funder Registry DOI when available (paper-coherence warning per PALS's LAW)." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this ap:registryId ?r }
            }
        """ ;
    ] .

# ---- B.22  Table ----------------------------------------------------------

ap:TableShape
    a sh:NodeShape ;
    sh:targetClass ap:Table ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "table-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:section ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Section ] ;
    sh:property [ sh:path ap:label ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:caption ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:captionLanguage ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[a-z]{2}$" ] ;
    sh:property [ sh:path ap:page ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minExclusive 0 ] ;
    sh:property [ sh:path ap:altText ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path ap:contentRef ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ap:rowCount    ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ] ;
    sh:property [ sh:path ap:columnCount ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ] ;
    sh:property [ sh:path ap:headerRows  ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ] ;
    sh:property [ sh:path ap:doi ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] .

# ---- B.23  PaperRelation --------------------------------------------------

ap:PaperRelationShape
    a sh:NodeShape ;
    sh:targetClass ap:PaperRelation ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "prel-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:relatedWork ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Work ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "companion-of" "commentary-on" "correction-of" "response-to"
                          "reply-to-letter" "retraction-of" "republication-of"
                          "translation-of" "addendum-to" ) ] ;
    sh:property [ sh:path ap:rationale ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 2000 ] .

# ---- B.24  Erratum (NEW v0.4) ---------------------------------------------
#
# Within-paper corrigendum / retraction / expression-of-concern /
# addendum / erratum notice. Aligned with NISO STM Article Versions
# correction lifecycle and Crossmark update-type taxonomy. Each
# Erratum is scoped to a single Paper and may point to one or more
# of the four correctable element types: Section, Claim, Finding,
# Equation.
#
# Ref-integrity (corrects* targets must belong to the same paper)
# is enforced on the Refined root (B.99.16). Entity-level rule that
# a non-retraction Erratum must reference ≥1 corrects* target is
# enforced by sh:sparql below (mirrors the Zod entity refine).

ap:ErratumShape
    a sh:NodeShape ;
    sh:targetClass ap:Erratum ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ap:_meta ) ;

    sh:property [ sh:path ap:id ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "erratum-[a-z0-9-]+$" ] ;
    sh:property [ sh:path ap:paper ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:class ap:Paper ] ;
    sh:property [ sh:path ap:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "correction" "erratum" "retraction"
                          "expression-of-concern" "addendum" ) ] ;
    sh:property [ sh:path ap:title ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:body ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 20000 ] ;
    sh:property [ sh:path ap:issuedDate ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ;
    sh:property [ sh:path ap:noticeDoi ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$" ] ;
    sh:property [ sh:path ap:correctsSection  ; sh:nodeKind sh:IRI ; sh:class ap:Section  ] ;
    sh:property [ sh:path ap:correctsClaim    ; sh:nodeKind sh:IRI ; sh:class ap:Claim    ] ;
    sh:property [ sh:path ap:correctsFinding  ; sh:nodeKind sh:IRI ; sh:class ap:Finding  ] ;
    sh:property [ sh:path ap:correctsEquation ; sh:nodeKind sh:IRI ; sh:class ap:Equation ] ;

    # Entity-level refine: non-retraction Erratum must point to ≥1 corrects* target.
    # Retraction notices may nullify the paper wholesale without per-element targets.
    sh:sparql [
        sh:message "non-retraction Erratum must reference ≥1 of correctsSection / correctsClaim / correctsFinding / correctsEquation" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:kind ?k .
                FILTER (?k != \"retraction\")
                FILTER NOT EXISTS { $this ap:correctsSection  ?s }
                FILTER NOT EXISTS { $this ap:correctsClaim    ?c }
                FILTER NOT EXISTS { $this ap:correctsFinding  ?f }
                FILTER NOT EXISTS { $this ap:correctsEquation ?e }
            }
        """ ;
    ] .

# ---- B.A  Confidence + Provenance value-object shapes --------------------

ap:ConfidenceShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [ sh:path ap:level ; sh:maxCount 1 ;
                  sh:in ( "speculative" "low" "moderate" "high" "verified" ) ] ;
    # rev3: accept xsd:decimal OR xsd:double. JSON-LD serializes JS
    # numbers as xsd:double by default, so the previous xsd:decimal-only
    # constraint would reject round-tripped workbook data even when the
    # Zod schema considers it valid.
    sh:property [ sh:path ap:score ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ;
                  sh:or (
                      [ sh:datatype xsd:decimal ]
                      [ sh:datatype xsd:double  ]
                  ) ] ;

    sh:sparql [
        sh:message "Confidence requires at least one of `level` or `score`." ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this ap:level ?l }
                FILTER NOT EXISTS { $this ap:score ?s }
            }
        """ ;
    ] .

ap:ProvenanceShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [ sh:path ap:sourceType ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "primary_text" "secondary_literature" "archival_record"
                          "dataset" "interview" "observation" "derivation"
                          "model_output" "personal_communication" "unknown" ) ] ;
    sh:property [ sh:path ap:sourceLabel ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 280 ] ;
    sh:property [ sh:path ap:sourceUrl ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^https?://" ] ;
    sh:property [ sh:path ap:retrievedAt ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] .

# ============================================================================
# LAYER B.99  —  Cross-cutting invariants on the Paper shape
#
# All Refined-root rules from academic-paper.ts §8 land here as sh:sparql
# constraints on ap:PaperShape (via sh:targetClass ap:Paper). Each rule is
# a separate sh:sparql so violations report independently.
# ============================================================================

ap:PaperShape
    # B.99.1  At least one Author per Paper.
    sh:sparql [
        sh:message "paper must have at least one Author" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?a a ap:Author ; ap:paper $this }
            }
        """ ;
    ] ;

    # B.99.2  Every Author of this paper must have ≥ 1 Affiliation.
    sh:sparql [
        sh:message "every Author must declare at least one Affiliation" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?a WHERE {
                ?a a ap:Author ; ap:paper $this .
                FILTER NOT EXISTS { ?a ap:affiliations ?aff }
            }
        """ ;
    ] ;

    # B.99.3  At most one Author per paper has position='first'.
    sh:sparql [
        sh:message "at most one Author may have position='first' (per paper)" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                {
                    SELECT $this (COUNT(?a) AS ?n) WHERE {
                        ?a a ap:Author ; ap:paper $this ; ap:position \"first\" .
                    } GROUP BY $this
                }
                FILTER (?n > 1)
            }
        """ ;
    ] ;

    # B.99.4  At most one Author per paper has position='last'.
    sh:sparql [
        sh:message "at most one Author may have position='last' (per paper)" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                {
                    SELECT $this (COUNT(?a) AS ?n) WHERE {
                        ?a a ap:Author ; ap:paper $this ; ap:position \"last\" .
                    } GROUP BY $this
                }
                FILTER (?n > 1)
            }
        """ ;
    ] ;

    # B.99.5  publicationDate.year must equal year (when both bound).
    sh:sparql [
        sh:message "paper.publicationDate's year must agree with paper.year" ;
        sh:select  """
            PREFIX ap:  <https://example.org/academic-paper/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this ap:publicationDate ?pd ; ap:year ?y .
                BIND(xsd:integer(SUBSTR(STR(?pd), 1, 4)) AS ?pyear)
                FILTER (?pyear != xsd:integer(?y))
            }
        """ ;
    ] ;

    # B.99.6  Every Concept used in this workbook must have either a
    # Definition that targets it, or a non-empty borrowsFrom.
    sh:sparql [
        sh:message "Concept must either have a Definition in this paper or a borrowsFrom→Theorist link" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?c WHERE {
                ?c a ap:Concept .
                FILTER NOT EXISTS { ?d a ap:Definition ; ap:paper $this ; ap:concept ?c }
                FILTER NOT EXISTS { ?c ap:borrowsFrom ?t }
            }
        """ ;
    ] ;

    # ---- KIND-CONDITIONAL CEL (5 rules from academic-paper.ts §8 (B)) ----

    # B.99.7  epistemicMethod='theoretical' ⇒ ≥ 1 Equation tied to this paper.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'theoretical' requires at least one Equation" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"theoretical\" .
                FILTER NOT EXISTS { ?eq a ap:Equation ; ap:paper $this }
            }
        """ ;
    ] ;

    # B.99.8  epistemicMethod='empirical' ⇒ ≥ 1 Claim of kind='hypothesis'.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'empirical' requires ≥1 Claim of kind 'hypothesis'" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"empirical\" .
                FILTER NOT EXISTS {
                    ?c a ap:Claim ; ap:paper $this ; ap:kind \"hypothesis\" .
                }
            }
        """ ;
    ] ;

    # B.99.9  epistemicMethod='empirical' ⇒ ∃ empirical Claim with data Evidence.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'empirical' requires ≥1 empirical Claim supported by Evidence of kind 'data'" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"empirical\" .
                FILTER NOT EXISTS {
                    ?c a ap:Claim ; ap:paper $this ; ap:kind \"empirical\" .
                    ?e a ap:Evidence ; ap:supports ?c ; ap:kind \"data\" .
                }
            }
        """ ;
    ] ;

    # B.99.10  epistemicMethod='literary-critical' ⇒ ≥ 1 Quotation.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'literary-critical' requires at least one Quotation" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"literary-critical\" .
                FILTER NOT EXISTS { ?q a ap:Quotation ; ap:paper $this }
            }
        """ ;
    ] ;

    # B.99.11  epistemicMethod='review' ⇒ ≥ 10 distinct cited Works across
    # Citations of review-relevant kinds.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'review' requires ≥10 distinct cited Works across Citations of kind ∈ {reviews, critiques, agrees-with, disagrees-with, qualifies, extends, confirms, refutes}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"review\" .
                {
                    SELECT $this (COUNT(DISTINCT ?w) AS ?n) WHERE {
                        ?ci a ap:Citation ; ap:paper $this ; ap:citedWork ?w ; ap:kind ?k .
                        FILTER (?k IN (\"reviews\", \"critiques\", \"agrees-with\",
                                       \"disagrees-with\", \"qualifies\", \"extends\",
                                       \"confirms\", \"refutes\"))
                    } GROUP BY $this
                }
                FILTER (?n < 10)
            }
        """ ;
    ] ;

    # B.99.12  epistemicMethod='historical' ⇒ ≥ 1 Evidence of kind ∈
    # {observation, data}.
    sh:sparql [
        sh:message "paper.epistemicMethod == 'historical' requires ≥1 Evidence of kind 'observation' or 'data'" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this WHERE {
                $this ap:epistemicMethod \"historical\" .
                FILTER NOT EXISTS {
                    ?e a ap:Evidence ; ap:paper $this ; ap:kind ?k .
                    FILTER (?k IN (\"observation\", \"data\"))
                }
            }
        """ ;
    ] ;

    # ──────────────── v0.4 additions (B.99.13 – B.99.16) ────────────────

    # B.99.13  Claim.supersededBy must resolve to a Claim in this paper
    #          AND may not be a self-loop.
    sh:sparql [
        sh:message "Claim.supersededBy must resolve to an existing Claim in this paper and may not self-loop" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?c ?target WHERE {
                ?c a ap:Claim ; ap:paper $this ; ap:supersededBy ?target .
                {
                    FILTER (?c = ?target)
                } UNION {
                    FILTER NOT EXISTS { ?target a ap:Claim ; ap:paper $this }
                }
            }
        """ ;
    ] ;

    # B.99.14  Finding.testsHypothesis must resolve to a Claim of
    #          kind='hypothesis' in this paper.
    sh:sparql [
        sh:message "Finding.testsHypothesis must point to a Claim of kind='hypothesis' in this paper" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?f ?h WHERE {
                ?f a ap:Finding ; ap:paper $this ; ap:testsHypothesis ?h .
                FILTER NOT EXISTS {
                    ?h a ap:Claim ; ap:paper $this ; ap:kind \"hypothesis\" .
                }
            }
        """ ;
    ] ;

    # B.99.15  Hypothesis-Finding closure: every Claim of kind='hypothesis'
    #          must be referenced by at least one Finding.testsHypothesis.
    #          Fires only when paper.epistemicMethod ∈ {empirical,
    #          theoretical, historical}; other methods exempt (mirrors
    #          the Zod refined-root gate).
    sh:sparql [
        sh:message "every hypothesis Claim must be referenced by at least one Finding.testsHypothesis (empirical/theoretical/historical papers)" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?h WHERE {
                $this ap:epistemicMethod ?m .
                FILTER (?m IN (\"empirical\", \"theoretical\", \"historical\"))
                ?h a ap:Claim ; ap:paper $this ; ap:kind \"hypothesis\" .
                FILTER NOT EXISTS {
                    ?f a ap:Finding ; ap:paper $this ; ap:testsHypothesis ?h .
                }
            }
        """ ;
    ] ;

    # B.99.16  Erratum corrects* ref-integrity: every correctsSection /
    #          correctsClaim / correctsFinding / correctsEquation pointer
    #          on an Erratum scoped to this paper must resolve to a target
    #          of the right rdf:type AND belong to this same paper.
    sh:sparql [
        sh:message "Erratum.correctsSection must resolve to a Section in this paper" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?er ?t WHERE {
                ?er a ap:Erratum ; ap:paper $this ; ap:correctsSection ?t .
                FILTER NOT EXISTS { ?t a ap:Section ; ap:paper $this }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Erratum.correctsClaim must resolve to a Claim in this paper" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?er ?t WHERE {
                ?er a ap:Erratum ; ap:paper $this ; ap:correctsClaim ?t .
                FILTER NOT EXISTS { ?t a ap:Claim ; ap:paper $this }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Erratum.correctsFinding must resolve to a Finding in this paper" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?er ?t WHERE {
                ?er a ap:Erratum ; ap:paper $this ; ap:correctsFinding ?t .
                FILTER NOT EXISTS { ?t a ap:Finding ; ap:paper $this }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Erratum.correctsEquation must resolve to an Equation in this paper" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this ?er ?t WHERE {
                ?er a ap:Erratum ; ap:paper $this ; ap:correctsEquation ?t .
                FILTER NOT EXISTS { ?t a ap:Equation ; ap:paper $this }
            }
        """ ;
    ] .

# ============================================================================
# LAYER B.CYCLES  —  Cycle detection (7 relations, mirror of TS §8 lines 1782-1853)
#
# rev3 enhancement: each cycle shape now reports the ring members, not
# just "$this is on a cycle". The SPARQL groups all nodes that share a
# cycle with $this via GROUP_CONCAT, and the sh:message template
# interpolates {?path} so consumers see the offending ring.
#
# Note: SHACL SPARQL constraints fire one validation result per row
# returned. The query returns 0 rows for nodes not on a cycle and 1
# row per cycle-bearing focus node (with all co-cycle members joined
# by " → "). Ordering inside the GROUP_CONCAT is not guaranteed by
# the SPARQL spec — the message lists ring *members*, not an ordered
# walk. That is still strictly more informative than the rev2 form,
# which surfaced only $this.
# ============================================================================

ap:SectionParentCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Section ;
    sh:sparql [
        sh:message "cycle detected in sections.parent at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:parent+ $this .
                $this ap:parent+ ?n .
                ?n    ap:parent+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:ConceptExtendsCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Concept ;
    sh:sparql [
        sh:message "cycle detected in concepts.extends at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:extends+ $this .
                $this ap:extends+ ?n .
                ?n    ap:extends+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:ClaimDerivesFromCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Claim ;
    sh:sparql [
        sh:message "cycle detected in claims.derivesFrom at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:derivesFrom+ $this .
                $this ap:derivesFrom+ ?n .
                ?n    ap:derivesFrom+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:EquationDerivesFromCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Equation ;
    sh:sparql [
        sh:message "cycle detected in equations.derivesFrom at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:derivesFrom+ $this .
                $this ap:derivesFrom+ ?n .
                ?n    ap:derivesFrom+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:TheoryExtendsCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Theory ;
    sh:sparql [
        sh:message "cycle detected in theories.extendsTheory at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:extendsTheory+ $this .
                $this ap:extendsTheory+ ?n .
                ?n    ap:extendsTheory+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:WorkTranslationOfCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Work ;
    sh:sparql [
        sh:message "cycle detected in works.translationOf at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:translationOf+ $this .
                $this ap:translationOf+ ?n .
                ?n    ap:translationOf+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

ap:WorkEditionOfCycleShape
    a sh:NodeShape ;
    sh:targetClass ap:Work ;
    sh:sparql [
        sh:message "cycle detected in works.editionOf at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:editionOf+ $this .
                $this ap:editionOf+ ?n .
                ?n    ap:editionOf+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

