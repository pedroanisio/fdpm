# ----------------------------------------------------------------------------
# In-place fix patch additions (2026-05-12): cycle shapes for two relations
# that the previous rev3 omitted.
# ----------------------------------------------------------------------------

# [ADDED] Transitive cycle detection for Claim.supersededBy. B.99.13 catches
# self-loops (c supersededBy c) and unresolved refs but not chains
# (A supersededBy B supersededBy A). Acyclicity is the standard FDPM
# invariant for any "supersedes" relation.
ap:ClaimSupersededByCycleShape
    a sh:NodeShape ;
    rdfs:comment """Added rev3 fix patch: acyclic invariant on ap:supersededBy (Claim → Claim). Closes a coverage gap — B.99.13 catches self-loops and unresolved references but not transitive cycles (A → B → A).""" ;
    sh:targetClass ap:Claim ;
    sh:sparql [
        sh:message "cycle detected in claims.supersededBy at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:supersededBy+ $this .
                $this ap:supersededBy+ ?n .
                ?n    ap:supersededBy+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

# [ADDED] Transitive cycle detection for Quotation.translatedFrom.
ap:QuotationTranslatedFromCycleShape
    a sh:NodeShape ;
    rdfs:comment """Added rev3 fix patch: acyclic invariant on ap:translatedFrom (Quotation → Quotation). The seven canonical acyclic-graph rules in the FDPM profile registry omitted this edge; the shape closes the gap.""" ;
    sh:targetClass ap:Quotation ;
    sh:sparql [
        sh:message "cycle detected in quotations.translatedFrom at {$this}; ring members: {?path}" ;
        sh:select  """
            PREFIX ap: <https://example.org/academic-paper/>
            SELECT $this (GROUP_CONCAT(DISTINCT STR(?n); separator=\" → \") AS ?path) WHERE {
                $this ap:translatedFrom+ $this .
                $this ap:translatedFrom+ ?n .
                ?n    ap:translatedFrom+ $this .
            }
            GROUP BY $this
        """ ;
    ] .

